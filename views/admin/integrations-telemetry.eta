<% layout("/layouts/admin", { page: it.page }) %>
<%~ include("/partials/admin-nav", { page: it.page, nav: it.nav }) %>
<main id="main-content" class="admin-page">
  <%~ include("/partials/page-header", {
    title: "Telemetry",
    intro: "Manage the machine keys used by devices that report Tap measurements. A source must be assigned to a Tap before it can report.",
  }) %>
  <%~ include("/partials/tabs", { tabs: it.tabs }) %>
  <%~ include("/partials/admin-messages", { page: it.page }) %>
  <section aria-labelledby="telemetry-usage-heading">
    <h2 id="telemetry-usage-heading">Connect a telemetry device</h2>
    <ol>
      <li>Create a source and copy the machine key shown once.</li>
      <li>Assign the source to a Tap as its level, condition, or flow source (one source can hold several roles) before sending measurements.</li>
      <li>Send measurements with the full key in the Bearer header.</li>
    </ol>
    <p>Endpoint: <code>POST /api/v1/telemetry/taps/{tapNumber}</code></p>
  </section>
  <%~ include("/partials/filter-form", it.filter) %>
  <section aria-labelledby="active-telemetry-heading">
    <%~ include("/partials/section-heading", {
      id: "active-telemetry-heading",
      title: "Active sources",
      intro: "Sources that can currently authenticate and report measurements.",
      actions: [{ label: "Add source", href: "/admin/integrations/telemetry/new", primary: true }],
    }) %>
    <% if (it.activeSources.length === 0) { %>
      <%~ include("/partials/empty-state", {
        title: "No active telemetry sources",
        level: 3,
        text: "Create a source to issue the first machine key.",
      }) %>
    <% } else { %>
      <div class="auto-grid auto-grid--lg">
        <% for (const source of it.activeSources) { %>
          <article class="card integration-source-card">
            <%~ include("/partials/section-heading", {
              title: source.name,
              titleHref: `/admin/integrations/telemetry-sources/${source.id}`,
              level: 3,
              badge: { label: "Active", tone: "healthy" },
            }) %>
            <dl>
              <div><dt>Key identifier</dt><dd><code><%= source.keyPublicId %></code></dd></div>
              <div><dt>Created</dt><dd><time datetime="<%= source.keyCreatedAt %>"><%= source.keyCreatedAtLabel %></time></dd></div>
            </dl>
            <a class="button button--secondary button--small" href="/admin/integrations/telemetry-sources/<%= source.id %>">Open source</a>
          </article>
        <% } %>
      </div>
    <% } %>
    <% if (it.activePages) { %>
      <%~ include("/partials/pagination", it.activePages) %>
    <% } %>
  </section>
  <section aria-labelledby="disabled-telemetry-heading">
    <%~ include("/partials/section-heading", {
      id: "disabled-telemetry-heading",
      title: "Disabled source history",
      intro: "Immutable record of revoked sources and their key lineage.",
    }) %>
      <% if (it.disabledSources.length === 0) { %>
        <%~ include("/partials/empty-state", { text: "No disabled sources." }) %>
      <% } else { %>
        <div class="auto-grid auto-grid--lg">
          <% for (const source of it.disabledSources) { %>
            <article class="card integration-source-card integration-source-card--disabled">
              <%~ include("/partials/section-heading", {
                title: source.name,
                titleHref: `/admin/integrations/telemetry-sources/${source.id}`,
                level: 3,
                badge: { label: "Disabled" },
              }) %>
              <dl>
                <div><dt>Key identifier</dt><dd><code><%= source.keyPublicId %></code></dd></div>
                <div><dt>Disabled</dt><dd><time datetime="<%= source.disabledAt %>"><%= source.disabledAtLabel %></time></dd></div>
              </dl>
              <a class="button button--secondary button--small" href="/admin/integrations/telemetry-sources/<%= source.id %>">View history</a>
            </article>
          <% } %>
        </div>
      <% } %>
      <% if (it.historyPages) { %>
        <%~ include("/partials/pagination", it.historyPages) %>
      <% } %>
  </section>
</main>
