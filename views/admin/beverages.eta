<% layout("/layouts/admin", { page: it.page }) %>
<%~ include("/partials/admin-nav", { page: it.page, nav: it.nav }) %>
<main id="main-content" class="admin-page">
  <%~ include("/partials/page-header", {
    title: "Beverages",
    intro: "A searchable library of every beverage available to the tapboard.",
  }) %>
  <%~ include("/partials/admin-messages", { page: it.page }) %>
  <%~ include("/partials/section-heading", {
    id: "beverage-library-heading",
    title: "Beverage library",
    intro: `${it.pagination.total} beverage${it.pagination.total === 1 ? "" : "s"}`,
    actions: [{ label: "Add beverage", href: "/admin/beverages/new", primary: true }],
  }) %>
  <%~ include("/partials/filter-form", it.filter) %>
  <% if (it.beverages.length === 0) { %>
    <%~ include("/partials/empty-state", { ...it.empty, id: "beverage-empty-heading" }) %>
  <% } else { %>
      <table class="table table--library">
        <caption class="sr-only">Beverage library</caption>
        <thead><tr><th scope="col">Beverage</th><th scope="col">Style</th><th scope="col">ABV</th><th scope="col">Source</th><th scope="col">Current use</th></tr></thead>
        <tbody>
          <% for (const beverage of it.beverages) { %>
            <tr data-row-href="/admin/beverages/<%= beverage.id %>">
              <th scope="row"><div class="library-cell">
                <div class="library-cell__preview"><%~ include("/partials/fill-graphic", { tap: beverage.vessel }) %></div>
                <a class="library-cell__name" href="/admin/beverages/<%= beverage.id %>">
                  <span><%= beverage.name %></span>
                </a>
                <span class="library-cell__type"><%= beverage.beverageTypeLabel %><% if (beverage.fillGlass) { %> · <%= beverage.fillGlass %><% } %></span>
              </div></th>
              <td data-label="Style"><%= beverage.style || "—" %></td>
              <td data-label="ABV"><%= beverage.abv === null ? "—" : `${beverage.abv}%` %></td>
              <td data-label="Source"><%~ include("/partials/status-badge", { label: beverage.source }) %></td>
              <td data-label="Current use"><%= beverage.currentUsage === 0 ? "Not in use" : `${beverage.currentUsage} active fill${beverage.currentUsage === 1 ? "" : "s"}` %></td>
            </tr>
          <% } %>
        </tbody>
      </table>
    <% if (it.pageNavigation) { %>
      <%~ include("/partials/pagination", it.pageNavigation) %>
    <% } %>
  <% } %>
  <% if (it.brewfatherCandidates && it.brewfatherCandidates.length > 0) { %>
    <section aria-labelledby="brewfather-candidates-heading">
      <%~ include("/partials/section-heading", {
        id: "brewfather-candidates-heading",
        title: "Unlinked Brewfather batches",
        intro: "Link a cached batch only when you are ready to manage it here.",
      }) %>
        <div class="auto-grid auto-grid--lg">
          <% for (const candidate of it.brewfatherCandidates) { %>
            <article class="card">
              <h3><%= candidate.name %></h3>
              <p class="muted"><% if (candidate.number) { %>Batch <%= candidate.number %> · <% } %><%= candidate.status %><% if (candidate.style) { %> · <%= candidate.style %><% } %></p>
              <form action="/admin/beverages/brewfather/link" method="post"><input type="hidden" name="_csrf"
                value="<%= it.page.csrfToken %>" /><input type="hidden" name="sourceBatchId"
                value="<%= candidate.sourceBatchId %>" /><button class="button button--secondary"
                type="submit">Link as beverage</button></form>
            </article>
          <% } %>
        </div>
    </section>
  <% } %>
</main>
