<% layout("/layouts/admin", { page: it.page }) %>
<%~ include("/partials/admin-nav", { page: it.page, items: it.navItems }) %>
<main id="main-content" class="admin-page">
  <header class="page-header">
    <div>
      <h1>Tap <%= it.tap.identity.tapNumber %><% if (it.tap.identity.name) { %> — <%= it.tap.identity.name %><% } else { %> — (unnamed)<% } %></h1>
    </div>
    <span class="badge<%= it.tap.lifecycle.enabled && !it.tap.lifecycle.isRetired ? " badge--active" : "" %>"><%= it.tap.lifecycle.isRetired ? "Retired" : it.tap.lifecycle.enabled ? "Enabled" : "Disabled" %></span>
  </header>
  <%~ include("/partials/tabs", { tabs: it.tabs }) %>
  <%~ include("/partials/admin-messages", { page: it.page }) %>

<% if (it.tab === "card") { %>
  <section aria-labelledby="public-preview-heading">
    <div class="header-row"><div><h2 id="public-preview-heading">Public preview</h2></div></div>
    <div data-tap-preview>
    <% if (it.tap.publicPreview) { %>
      <div class="display-preview tap-public-preview__frame" data-display-preview data-preview-theme="<%= it.tap.displayDefaults.theme || 'modern_dark' %>" data-preview-accent="<%= it.tap.displayDefaults.accent || 'theme' %>" data-preview-font="<%= it.tap.displayDefaults.font || 'system' %>" data-preview-unit-system="<%= it.tap.displayDefaults.unitSystem || 'us' %>" data-preview-show-serving-temperature="<%= it.tap.displayDefaults.showServingTemperature !== false %>"><%~ include("/partials/tap-card", { tap: it.tap.publicPreview, sharedDisplay: it.tap.displayDefaults }) %></div>
    <% } else { %>
      <p class="muted">No public card is available for this disabled, retired, or unassigned Tap.</p>
    <% } %>
    </div>
  </section>

  <section aria-labelledby="public-card-heading">
    <div class="header-row"><div><h2 id="public-card-heading">On the public card</h2></div></div>
    <% if (it.tap.cardMetrics.length > 0) { %>
      <p class="muted">Each switch saves at once. A metric you change here stops following <a href="/admin/display/shared">Display › Default theme</a> until you reset it.</p>
      <ul class="tap-card-metrics" aria-labelledby="public-card-heading" data-card-metrics>
        <% for (const metric of it.tap.cardMetrics) { %>
          <li class="cluster" data-metric-field="<%= metric.field %>" data-display-default="<%= metric.displayDefault %>">
            <form action="/admin/taps/<%= it.tap.identity.id %>/display" method="post" data-autosave="submit" data-autosave-fields="<%= metric.field %>" data-autosave-resource="tap:<%= it.tap.identity.id %>" data-autosave-revision="updatedAt" data-autosave-status-id="card-metrics-status" data-metric-toggle><input type="hidden" name="_csrf" value="<%= it.page.csrfToken %>" /><input type="hidden" name="updatedAt" value="<%= it.tap.identity.updatedAt %>" /><input type="hidden" name="<%= metric.field %>" value="<%= metric.shown ? "hide" : "show" %>" /><button type="submit" class="switch" role="switch" aria-checked="<%= metric.shown %>"><span class="switch__control" aria-hidden="true"></span><span><%= metric.label %> <small data-metric-source><%= metric.overridden ? "This Tap only" : "Display default" %></small></span></button></form>
            <form action="/admin/taps/<%= it.tap.identity.id %>/display" method="post" data-autosave="submit" data-autosave-fields="<%= metric.field %>" data-autosave-resource="tap:<%= it.tap.identity.id %>" data-autosave-revision="updatedAt" data-autosave-status-id="card-metrics-status" data-metric-reset<% if (!metric.overridden) { %> hidden<% } %>><input type="hidden" name="_csrf" value="<%= it.page.csrfToken %>" /><input type="hidden" name="updatedAt" value="<%= it.tap.identity.updatedAt %>" /><input type="hidden" name="<%= metric.field %>" value="inherit" /><button type="submit" class="button button--secondary button--icon" aria-label="Reset <%= metric.label %> to Display default" title="Reset <%= metric.label %> to Display default"><svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M4 4v5h5" /><path d="M5.6 15a7.5 7.5 0 1 0 .8-7.4L4 9" /></svg></button></form>
          </li>
        <% } %>
      </ul>
      <output id="card-metrics-status" class="autosave-status" data-autosave-status aria-live="polite"></output>
    <% } else { %>
      <p class="muted">Per-Tap display settings are unavailable.</p>
    <% } %>
  </section>

  <section aria-labelledby="mystery-heading">
    <div class="header-row"><div><h2 id="mystery-heading">Mystery Tap</h2></div></div>
    <% if (!it.tap.assignment.active || !it.tap.assignment.mystery) { %>
      <p class="muted">Mystery settings are unavailable until this Tap has an active Fill assignment.</p>
    <% } else { %>
      <p class="muted">A Mystery Tap hides the Tap and beverage names. Guests see only the fields you reveal.</p>
      <form class="form" action="/admin/taps/<%= it.tap.identity.id %>/mystery" method="post" data-autosave="blur" data-autosave-resource="tap:<%= it.tap.identity.id %>" data-autosave-revision="updatedAt" data-autosave-fields="enabled,revealBeverageType,revealStyle,revealAbv,revealIbu,revealOg,revealFg,revealSrm,revealDescription,revealRecipe,revealSensory,revealHistory">
        <input type="hidden" name="_csrf" value="<%= it.page.csrfToken %>" /><input type="hidden" name="updatedAt" value="<%= it.tap.identity.updatedAt %>" />
        <label class="switch"><input class="switch__control" role="switch" type="checkbox" name="enabled" value="true"<% if (it.tap.assignment.mystery.enabled) { %> checked<% } %> /> Enable Mystery Tap</label>
        <fieldset class="fieldset"><legend>Reveal to guests</legend><div class="auto-grid auto-grid--xs"><% for (const field of [["revealBeverageType", "Beverage type"], ["revealStyle", "Style"], ["revealAbv", "ABV"], ["revealIbu", "IBU"], ["revealOg", "OG"], ["revealFg", "FG"], ["revealSrm", "SRM"], ["revealDescription", "Description"], ["revealRecipe", "Recipe"], ["revealSensory", "Sensory profile"], ["revealHistory", "Fill history"]]) { %><label class="switch"><input class="switch__control" role="switch" type="checkbox" name="<%= field[0] %>" value="true"<% if (it.tap.assignment.mystery[field[0]]) { %> checked<% } %> /> <%= field[1] %></label><% } %></div></fieldset>
        <div class="form-actions"><button class="button button--primary button--small" type="submit" data-autosave-fallback>Save Mystery settings</button><output class="autosave-status" data-autosave-status aria-live="polite"></output></div>
      </form>
    <% } %>
  </section>
<% } else if (it.tab === "identity") { %>
  <section aria-labelledby="tap-identity-heading">
    <div class="header-row"><div><h2 id="tap-identity-heading">Identity</h2></div></div>
    <dl class="key-value-list">
      <div><dt>First used</dt><dd><%= it.tap.lifecycle.firstUsedAtLabel %></dd></div>
      <div><dt>Last updated</dt><dd><time datetime="<%= it.tap.identity.updatedAt %>"><%= it.tap.identity.updatedAtLabel %></time></dd></div>
    </dl>
    <form class="form" data-tap-name-form action="/admin/taps/<%= it.tap.identity.id %>/update" method="post" data-autosave="blur" data-autosave-resource="tap:<%= it.tap.identity.id %>" data-autosave-revision="updatedAt" data-autosave-fields="name">
      <input type="hidden" name="_csrf" value="<%= it.page.csrfToken %>" /><input type="hidden" name="updatedAt" value="<%= it.tap.identity.updatedAt %>" />
      <label class="field">Tap name <input name="name" maxlength="120" value="<%= it.tap.identity.name || "" %>" /></label>
      <div class="form-actions"><button class="button button--primary button--small" type="submit" data-autosave-fallback>Save name</button><output class="autosave-status" data-autosave-status aria-live="polite"></output></div>
    </form>
    <% if (!it.tap.lifecycle.isRetired) { %>
      <form class="form" action="/admin/taps/<%= it.tap.identity.id %>/update" method="post" data-autosave="blur" data-autosave-resource="tap:<%= it.tap.identity.id %>" data-autosave-revision="updatedAt" data-autosave-fields="tapNumber,enabled,gasType,servingPressureKpa,lineLengthMm,lineDiameterMm,notes,acknowledgeTelemetryEndpointImpact">
        <input type="hidden" name="_csrf" value="<%= it.page.csrfToken %>" />
        <input type="hidden" name="updatedAt" value="<%= it.tap.identity.updatedAt %>" />
        <div class="auto-grid auto-grid--sm">
          <label class="field">Tap number <input name="tapNumber" type="number" min="1" max="1000000" value="<%= it.tap.identity.tapNumber %>" required /></label>
          <label class="field">Public display <select name="enabled"><option value="true"<% if (it.tap.lifecycle.enabled) { %> selected<% } %>>Enabled</option><option value="false"<% if (!it.tap.lifecycle.enabled) { %> selected<% } %>>Disabled</option></select></label>
          <label class="field">Gas type <input name="gasType" maxlength="64" value="<%= it.tap.configuration.gasType || "" %>" /></label>
          <label class="field">Serving pressure (kPa) <input name="servingPressureKpa" type="number" min="0" step="any" value="<%= it.tap.configuration.servingPressureKpa ?? "" %>" /></label>
          <label class="field">Line length (mm) <input name="lineLengthMm" type="number" min="0" step="1" value="<%= it.tap.configuration.lineLengthMm ?? "" %>" /></label>
          <label class="field">Line diameter (mm) <input name="lineDiameterMm" type="number" min="0" step="any" value="<%= it.tap.configuration.lineDiameterMm ?? "" %>" /></label>
        </div>
        <label class="field">Notes <textarea name="notes" maxlength="2048" rows="4"><%= it.tap.configuration.notes || "" %></textarea></label>
        <label class="switch"><input class="switch__control" role="switch" name="acknowledgeTelemetryEndpointImpact" type="checkbox" value="true" /><span>I understand that changing the number changes <code>/api/v1/telemetry/taps/{tapNumber}</code>.</span></label>
        <div class="form-actions"><button class="button button--primary button--small" type="submit" data-autosave-fallback>Save Tap details</button><output class="autosave-status" data-autosave-status aria-live="polite"></output></div>
      </form>
    <% } else { %>
      <p class="muted">Retired Taps keep their number and history, so the number can't change.</p>
    <% } %>
  </section>

  <section id="assignment" aria-labelledby="assignment-heading">
    <div class="header-row"><div><h2 id="assignment-heading">Assignment</h2></div><% if (it.tap.assignment.active) { %><a class="button button--secondary button--small" href="/admin/keg-room/fills/<%= it.tap.assignment.active.fillId %>">Open Filled Keg</a><% } %></div>
    <% if (it.tap.assignment.active) { %>
        <table class="table">
          <caption class="sr-only">Current Tap assignment</caption>
          <thead><tr><th scope="col">Field</th><th scope="col">Value</th></tr></thead>
          <tbody>
            <tr><th scope="row">Fill</th><td><a href="/admin/keg-room/fills/<%= it.tap.assignment.active.fillId %>"><%= it.tap.assignment.active.beverageName %></a></td></tr>
            <tr><th scope="row">Physical keg</th><td><a href="/admin/keg-room/kegs/<%= it.tap.assignment.active.kegId %>">Keg <%= it.tap.assignment.active.kegNumber %><% if (it.tap.assignment.active.kegLabel) { %> — <%= it.tap.assignment.active.kegLabel %><% } %></a></td></tr>
            <tr><th scope="row">Assigned</th><td><%= it.tap.assignment.active.assignedAtLabel %></td></tr>
          </tbody>
        </table>
      <div class="tap-assignment-actions">
        <% if (it.tap.moveTargets.length > 0) { %>
          <form class="form tap-assignment-action" action="/admin/taps/<%= it.tap.identity.id %>/move" method="post">
            <input type="hidden" name="_csrf" value="<%= it.page.csrfToken %>" />
            <input type="hidden" name="updatedAt" value="<%= it.tap.identity.updatedAt %>" />
            <div class="tap-assignment-action__copy"><label for="tap-move-target">Move to another tap</label><p class="muted">The Filled Keg keeps its pours and history.</p></div>
            <div class="tap-assignment-action__controls">
              <select id="tap-move-target" name="targetTapId" required><% for (const target of it.tap.moveTargets) { %><option value="<%= target.id %>">Tap <%= target.tapNumber %><% if (target.name) { %> — <%= target.name %><% } %></option><% } %></select>
              <button class="button button--secondary button--small" type="submit">Move</button>
            </div>
          </form>
        <% } %>
        <form class="form tap-assignment-action" action="/admin/taps/<%= it.tap.identity.id %>/unassign" method="post">
          <input type="hidden" name="_csrf" value="<%= it.page.csrfToken %>" />
          <input type="hidden" name="updatedAt" value="<%= it.tap.identity.updatedAt %>" />
          <div class="tap-assignment-action__copy"><strong>Take off tap</strong><p class="muted">Returns the Filled Keg to the Keg Room as Available.</p></div>
          <div class="tap-assignment-action__controls"><button class="button button--secondary button--small" type="submit">Take off tap</button></div>
        </form>
        <%~ include("/partials/kick-keg-disclosure", { fillId: it.tap.assignment.active.fillId, csrfToken: it.page.csrfToken }) %>
      </div>
    <% } else if (it.tap.lifecycle.isRetired) { %>
      <p class="muted">Retired Taps cannot receive a new Fill assignment.</p>
    <% } else if (it.tap.assignableFills.length === 0) { %>
      <p class="muted">No available Filled Kegs can be assigned right now.</p>
    <% } else { %>
      <form class="form" action="/admin/taps/<%= it.tap.identity.id %>/assign" method="post">
        <input type="hidden" name="_csrf" value="<%= it.page.csrfToken %>" />
        <input type="hidden" name="updatedAt" value="<%= it.tap.identity.updatedAt %>" />
        <label class="field">Available Filled Keg <select name="fillId" required><option value="">Choose a Fill</option><% for (const fill of it.tap.assignableFills) { %><option value="<%= fill.id %>"><%= fill.label %></option><% } %></select></label>
        <button class="button button--primary button--small" type="submit">Assign Fill</button>
      </form>
    <% } %>
  </section>

  <% const tapHiddenFields = `<input type="hidden" name="_csrf" value="${it.page.csrfToken}" /><input type="hidden" name="updatedAt" value="${it.tap.identity.updatedAt}" />`; %>
  <% if (!it.tap.lifecycle.isRetired) { %>
    <section id="lifecycle" aria-labelledby="lifecycle-heading">
      <div class="header-row"><div><h2 id="lifecycle-heading">Lifecycle</h2><p class="muted">A retired Tap leaves the public display and keeps its number and history. Retiring can't be undone.</p></div></div>
      <%~ include("/partials/permanent-action", { id: `tap-retire-${it.tap.identity.id}`, blockers: it.tap.blockers.retire, action: `/admin/taps/${it.tap.identity.id}/retire`, hiddenFields: tapHiddenFields, reason: true, disclosure: "Retire Tap", buttonLabel: "Retire Tap" }) %>
    </section>
  <% } %>

  <section class="card card--danger" aria-labelledby="tap-delete-heading">
    <div class="header-row"><div><h2 id="tap-delete-heading">Permanent deletion</h2><p class="muted">Only a never-used, non-retired, unassigned Tap can be deleted. Deletion removes the Tap record and its deletion audit entry.</p></div></div>
    <% if (it.tap.deletionImpact) { %>
      <%~ include("/partials/permanent-action", { id: `tap-delete-${it.tap.identity.id}`, blockers: it.tap.blockers.delete, action: `/admin/taps/${it.tap.identity.id}/delete`, hiddenFields: tapHiddenFields, confirmation: { field: "confirmation", value: it.tap.identity.confirmationLabel }, reason: true, buttonLabel: "Permanently delete Tap" }) %>
    <% } else { %><p class="muted">Deletion impact is unavailable right now. <a href="/admin/taps/<%= it.tap.identity.id %>/identity">Try again <span aria-hidden="true">→</span></a></p><% } %>
  </section>
<% } else if (it.tab === "sensors") { %>
  <section aria-labelledby="sensors-heading">
    <div class="header-row"><div><h2 id="sensors-heading">Sensors</h2></div></div>
    <p class="muted"><%= it.tap.telemetry.authoritySummary %>. Latest pressure: <%= it.tap.telemetry.pressureLabel %>.</p>
    <form class="form" action="/admin/taps/<%= it.tap.identity.id %>/authority" method="post" data-autosave="blur" data-autosave-resource="tap:<%= it.tap.identity.id %>" data-autosave-revision="updatedAt" data-autosave-fields="levelSourceId,conditionSourceId,flowSourceId"><input type="hidden" name="_csrf" value="<%= it.page.csrfToken %>" /><input type="hidden" name="updatedAt" value="<%= it.tap.identity.updatedAt %>" /><p class="muted">One device can supply several roles. Readings a source sends for a role it doesn’t hold are ignored. With a flow source, pours come only from the flow meter and a scale gives remaining volume. Changing the level or flow source needs a fresh baseline.</p><label class="field">Level source (scale; pours unless a flow source is set) <select name="levelSourceId"><option value="">None</option><% for (const source of it.tap.telemetry.sources) { %><option value="<%= source.id %>"<% if (it.tap.telemetry.levelSourceId === source.id) { %> selected<% } %>><%= source.name %></option><% } %></select></label><label class="field">Condition source (temperature, pressure) <select name="conditionSourceId"><option value="">None</option><% for (const source of it.tap.telemetry.sources) { %><option value="<%= source.id %>"<% if (it.tap.telemetry.conditionSourceId === source.id) { %> selected<% } %>><%= source.name %></option><% } %></select></label><label class="field">Flow source (flow meter, pours) <select name="flowSourceId"><option value="">None</option><% for (const source of it.tap.telemetry.sources) { %><option value="<%= source.id %>"<% if (it.tap.telemetry.flowSourceId === source.id) { %> selected<% } %>><%= source.name %></option><% } %></select></label><div class="form-actions"><button class="button button--primary button--small" type="submit" data-autosave-fallback>Save telemetry sources</button><output class="autosave-status" data-autosave-status aria-live="polite"></output></div></form>
  </section>

  <section aria-labelledby="advanced-heading">
    <details class="disclosure">
      <summary id="advanced-heading">Advanced settings<small>Pour detector and health rules. Leave a field blank to use the global default.</small></summary>
      <h3>Pour detector</h3>
      <form class="form" action="/admin/taps/<%= it.tap.identity.id %>/detector-config" method="post" data-autosave="blur" data-autosave-resource="tap:<%= it.tap.identity.id %>" data-autosave-revision="updatedAt" data-autosave-fields="<%= it.tap.detector.fields.map((field) => `detector.${field.name}`).join(",") %>"><input type="hidden" name="_csrf" value="<%= it.page.csrfToken %>" /><input type="hidden" name="updatedAt" value="<%= it.tap.identity.updatedAt %>" /><p class="muted">Detection starts with measured volume loss, confirms the Tap during arbitration, records a meaningful pour, and waits for stability before recovery.</p><div class="stack stack--loose"><% for (const group of it.tap.detector.groups) { %><fieldset class="fieldset"><legend><%= group.title %></legend><p class="muted"><%= group.description %></p><div class="auto-grid auto-grid--sm"><% for (const field of group.fields) { %><label class="field" for="detector-field-<%= field.name %>"><span><%= field.label %></span><input id="detector-field-<%= field.name %>" name="detector.<%= field.name %>" type="number" step="any" value="<%= field.override === null ? "" : field.override %>" placeholder="Inherited: <%= field.effectiveLabel %>" aria-describedby="detector-help-<%= field.name %>" /><small id="detector-help-<%= field.name %>" class="field__help"><%= field.help %></small></label><% } %></div></fieldset><% } %></div><div class="form-actions"><button class="button button--primary button--small" type="submit" data-autosave-fallback>Save detector override</button><output class="autosave-status" data-autosave-status aria-live="polite"></output></div></form>
      <form class="form" action="/admin/taps/<%= it.tap.identity.id %>/rebaseline" method="post"><input type="hidden" name="_csrf" value="<%= it.page.csrfToken %>" /><input type="hidden" name="updatedAt" value="<%= it.tap.identity.updatedAt %>" /><button class="button button--secondary button--small" type="submit">Manual rebaseline</button></form>
      <h3>Health rules</h3>
      <p class="muted">Current aggregate: <strong><%= it.tap.health.overview.stateLabel %></strong><% if (it.tap.health.overview.severity !== "none") { %> · <%= it.tap.health.overview.severityLabel %><% } %>.</p>
      <% if (it.tap.health.overview.checks.length > 0) { %><ul class="compact-list"><% for (const check of it.tap.health.overview.checks) { %><li><strong><%= check.label %></strong>: <%= check.stateLabel %><% if (check.severity !== "none") { %> · <%= check.severityLabel %><% } %><% if (check.reasonLabel) { %> — <%= check.reasonLabel %><% } %></li><% } %></ul><% } %>
      <form class="form" action="/admin/taps/<%= it.tap.identity.id %>/health-config" method="post" data-autosave="blur" data-autosave-resource="tap:<%= it.tap.identity.id %>" data-autosave-revision="updatedAt" data-autosave-fields="<%= it.tap.health.sections.flatMap((section) => section.fields.map((field) => `health.${section.id}.${field.name}`)).join(",") %>"><input type="hidden" name="_csrf" value="<%= it.page.csrfToken %>" /><input type="hidden" name="updatedAt" value="<%= it.tap.identity.updatedAt %>" /><p class="muted">Each check below explains what it watches.</p><div class="stack stack--loose"><% for (const section of it.tap.health.sections) { %><fieldset class="fieldset"><legend><%= section.title %></legend><p class="muted"><%= section.description %></p><div class="auto-grid auto-grid--sm"><% for (const field of section.fields) { %><% if (typeof field.effective === "boolean") { %><label class="field" for="health-field-<%= section.id %>-<%= field.name %>"><span><%= field.label %></span><select id="health-field-<%= section.id %>-<%= field.name %>" name="health.<%= section.id %>.<%= field.name %>" aria-describedby="health-help-<%= section.id %>-<%= field.name %>"><option value="">Inherit (<%= field.effective ? "enabled" : "disabled" %>)</option><option value="true"<% if (field.override === true) { %> selected<% } %>>Enabled</option><option value="false"<% if (field.override === false) { %> selected<% } %>>Disabled</option></select><small id="health-help-<%= section.id %>-<%= field.name %>" class="field__help"><%= field.help %></small></label><% } else { %><label class="field" for="health-field-<%= section.id %>-<%= field.name %>"><span><%= field.label %></span><input id="health-field-<%= section.id %>-<%= field.name %>" name="health.<%= section.id %>.<%= field.name %>" type="number" step="any" value="<%= field.override === null ? "" : field.override %>" placeholder="Inherited: <%= field.effectiveLabel %>" aria-describedby="health-help-<%= section.id %>-<%= field.name %>" /><small id="health-help-<%= section.id %>-<%= field.name %>" class="field__help"><%= field.help %></small></label><% } %><% } %></div></fieldset><% } %></div><div class="form-actions"><button class="button button--primary button--small" type="submit" data-autosave-fallback>Save health override</button><output class="autosave-status" data-autosave-status aria-live="polite"></output></div></form>
    </details>
  </section>
<% } else if (it.tab === "maintenance") { %>
  <section aria-labelledby="maintenance-heading">
    <div class="header-row"><div><h2 id="maintenance-heading">Line maintenance</h2></div></div>
    <% if (it.tap.maintenance.records.length > 0) { %>
      <table class="table"><caption class="sr-only">Line maintenance, newest first</caption><thead><tr><th scope="col">Done</th><th scope="col">Type</th></tr></thead><tbody>
        <% for (const record of it.tap.maintenance.records) { %><tr><th scope="row"><time datetime="<%= record.performedAt %>"><%= record.performedAtLabel %></time></th><td data-label="Type"><%= record.typeLabel %></td></tr><% } %>
      </tbody></table>
    <% } else { %><p class="muted">No maintenance recorded yet.</p><% } %>
    <form class="form" action="/admin/taps/<%= it.tap.identity.id %>/maintenance" method="post"><input type="hidden" name="_csrf" value="<%= it.page.csrfToken %>" /><input type="hidden" name="updatedAt" value="<%= it.tap.identity.updatedAt %>" /><label class="field">Maintenance type <select name="maintenanceType"><option value="line_cleaned">Line cleaned</option><option value="sanitized">Sanitized</option><option value="inspection">Inspection</option><option value="repair">Repair</option><option value="other">Other</option></select></label><label class="field">Notes <textarea name="notes" maxlength="255"></textarea></label><button class="button button--primary button--small" type="submit">Record maintenance</button></form>
  </section>
<% } else { %>
  <section aria-labelledby="fill-history-heading">
    <div class="header-row"><div><h2 id="fill-history-heading">Fill history</h2><p class="muted">Every Filled Keg this Tap has poured, newest first (up to 50).</p></div></div>
    <% if (it.tap.history.fills.length === 0) { %><p class="muted">Nothing has been on this Tap yet.</p><% } else { %>
      <table class="table"><caption class="sr-only">Filled Kegs on this Tap, newest first</caption><thead><tr><th scope="col">Beverage</th><th scope="col">Physical keg</th><th scope="col">On tap</th><th scope="col">Off tap</th><th scope="col">How it ended</th></tr></thead><tbody>
        <% for (const fill of it.tap.history.fills) { %><tr><th scope="row"><a href="/admin/keg-room/fills/<%= fill.fillId %>"><%= fill.beverageName || "Unknown beverage" %></a></th><td data-label="Physical keg"><% if (fill.kegId) { %><a href="/admin/keg-room/kegs/<%= fill.kegId %>">Keg <%= fill.kegNumber %><% if (fill.kegLabel) { %> — <%= fill.kegLabel %><% } %></a><% } else { %>—<% } %></td><td data-label="On tap"><time datetime="<%= fill.assignedAt %>"><%= fill.assignedAtLabel %></time></td><td data-label="Off tap"><% if (fill.endedAt) { %><time datetime="<%= fill.endedAt %>"><%= fill.endedAtLabel %></time><% } else { %>—<% } %></td><td data-label="How it ended"><%= fill.endLabel %></td></tr><% } %>
      </tbody></table>
    <% } %>
  </section>

  <section aria-labelledby="tap-activity-heading">
    <div class="header-row"><div><h2 id="tap-activity-heading">Activity</h2><p class="muted">Changes recorded against this Tap, newest first. The <a href="/admin/logs">Activity log</a> has everything.</p></div></div>
    <% if (!it.tap.history.activity) { %><p class="muted">Activity is unavailable.</p><% } else if (it.tap.history.activity.items.length === 0) { %><p class="muted">No activity recorded for this Tap.</p><% } else { %>
      <table class="table"><caption class="sr-only">Activity for this Tap</caption><thead><tr><th scope="col">Time (UTC)</th><th scope="col">Action</th><th scope="col">Category</th><th scope="col">Actor</th></tr></thead><tbody>
        <% for (const item of it.tap.history.activity.items) { %><tr><td><time datetime="<%= item.occurredAt %>"><%= item.occurredAt %></time></td><td data-label="Action"><%= item.actionLabel %></td><td data-label="Category"><%= item.categoryLabel %></td><td data-label="Actor"><%= item.actorLabel %></td></tr><% } %>
      </tbody></table>
      <div class="cluster"><% if (it.tap.history.activity.nextHref) { %><a class="button button--secondary" href="<%= it.tap.history.activity.nextHref %>">Older activity</a><% } %><% if (it.tap.history.activity.hasCursor) { %><a class="button button--secondary" href="/admin/taps/<%= it.tap.identity.id %>/history">Latest activity</a><% } %></div>
    <% } %>
  </section>
<% } %>
</main>
<% if (it.tab === "card") { %><script type="module" src="/assets/js/admin-display.js"></script><% } %>
