<% const transport = it.transport; %>
<form class="form form--wide" action="/admin/integrations/outbound/create" method="post">
  <input type="hidden" name="_csrf" value="<%= it.page.csrfToken %>" />
  <input type="hidden" name="transport" value="<%= transport %>" />
  <div class="auto-grid auto-grid--md">
    <label class="field">Friendly name <input name="label" maxlength="120" required autocomplete="off" /></label>
    <label class="switch"><input class="switch__control" role="switch" type="checkbox" name="required" value="on"
      /><span>Required destination <small>When enabled, delivery health contributes to the required integration
      status.</small></span></label>
    <label class="switch"><input class="switch__control" role="switch" type="checkbox" name="enabled" value="on" checked
      /><span>Enabled <small>Disable while configuring a destination to prevent delivery
      attempts.</small></span></label>
  </div>

  <%~ include("/partials/outbound-subscriptions", { eventFields: it.eventFields,
    subscriptions: it.eventFields.map((field) => field.eventType),
    hint: "All six event types are selected by default for a new destination." }) %>

  <% if (transport === "home_assistant") { %>
    <fieldset class="fieldset">
      <legend>Home Assistant</legend>
      <p class="muted">Use an <code>http://</code> or <code>https://</code> Home Assistant base URL. The token is write-only.</p>
      <div class="auto-grid auto-grid--lg">
        <label class="field">Base URL <input name="baseUrl" type="url" maxlength="2048" placeholder="http://homeassistant.lan:8123" required autocomplete="off" /></label>
        <label class="field">Token <input name="token" type="password" maxlength="4096" placeholder="Paste token" autocomplete="new-password" /></label>
      </div>
    </fieldset>
  <% } else { %>
    <fieldset class="fieldset">
      <legend>Webhook</legend>
      <p class="muted">Endpoints must be public HTTP(S) addresses unless private network addresses are allowed below. Redirects are not followed.</p>
      <div class="auto-grid auto-grid--lg">
        <label class="field">Endpoint <input name="webhookUrl" type="url" maxlength="2048" placeholder="https://example.invalid/events" required autocomplete="off" /></label>
        <%~ include("/partials/outbound-payload-format", { payloadFormat: "standard" }) %>
      </div>
      <%~ include("/partials/outbound-private-network", { allowPrivateNetwork: false }) %>
    </fieldset>
  <% } %>

  <%~ include("/partials/outbound-headers", { maxHeaderRows: it.maxHeaderRows }) %>

  <div class="form-actions">
    <button class="button button--primary" type="submit">Create outbound destination</button>
    <a class="button button--secondary" href="/admin/integrations/outbound">Cancel</a>
  </div>
</form>
