<% layout("/layouts/admin", { page: it.page }) %>
<%~ include("/partials/admin-nav", { page: it.page, nav: it.nav }) %>
<main id="main-content" class="admin-page">
  <%~ include("/partials/page-header", {
    title: "Outbound delivery",
    intro: "Deliver selected Tapboard events to Home Assistant or an HTTP webhook. Credentials and endpoint values are never displayed.",
  }) %>
  <%~ include("/partials/tabs", { tabs: it.tabs }) %>
  <%~ include("/partials/admin-messages", { page: it.page }) %>
  <% if (!it.available) { %>
    <%~ include("/partials/empty-state", {
      id: "outbound-unavailable-heading",
      title: "Outbound delivery is unavailable",
      text: "The application composition has not enabled the outbound service.",
    }) %>
  <% } else { %>
    <%~ include("/partials/section-heading", {
      title: "Destinations",
      intro: "Each destination keeps its own subscription and delivery history.",
      actions: [
        { label: "Add Home Assistant", href: "/admin/integrations/outbound/new?transport=home_assistant" },
        { label: "Add webhook", href: "/admin/integrations/outbound/new?transport=webhook", primary: true },
      ],
    }) %>
    <% if (it.destinations.length === 0) { %>
      <%~ include("/partials/empty-state", {
        title: "No outbound destinations",
        text: "Create a destination to begin delivering events.",
      }) %>
    <% } else { %>
      <section class="auto-grid auto-grid--lg" aria-label="Outbound destinations">
        <% for (const destination of it.destinations) { %>
          <article class="card outbound-destination-card">
            <%~ include("/partials/section-heading", {
              title: destination.label,
              titleHref: `/admin/integrations/outbound/${encodeURIComponent(destination.id)}`,
              eyebrow: destination.transportLabel,
              badge: destination.badge,
            }) %>
            <dl class="key-value-list">
              <div><dt>Required</dt><dd><%= destination.required ? "Yes" : "No" %></dd></div>
              <div><dt>Subscriptions</dt><dd><%= destination.subscriptions.length %> of 6</dd></div>
              <div><dt>Version</dt><dd><%= destination.version ? destination.version.versionNumber : "—" %></dd></div>
            </dl>
            <% if (destination.disabledReason) { %><p class="status-line"><strong>Disabled:</strong> <%= destination.disabledReason %></p><% } %>
            <% if (destination.failure) { %><p class="status-line"><strong>Last safe error:</strong> <code><%= destination.failure.code %></code> · <%= destination.failure.failureClass %></p><% } %>
            <a class="button button--secondary button--small" href="/admin/integrations/outbound/<%= encodeURIComponent(destination.id) %>">Open destination</a>
          </article>
        <% } %>
      </section>
    <% } %>
  <% } %>
</main>
