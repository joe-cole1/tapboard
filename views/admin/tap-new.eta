<% layout("/layouts/admin", { page: it.page }) %>
<%~ include("/partials/admin-nav", { page: it.page, nav: it.nav }) %>
<main id="main-content" class="admin-page">
  <%~ include("/partials/page-header", {
    title: "New Tap",
    intro: "Create a serving position first; assignment and operational controls are available after it exists.",
  }) %>
  <%~ include("/partials/admin-messages", { page: it.page }) %>
  <section aria-labelledby="new-tap-heading">
    <h2 id="new-tap-heading">Tap identity and serving setup</h2>
    <form class="form" action="/admin/taps/create" method="post">
      <input type="hidden" name="_csrf" value="<%= it.page.csrfToken %>" />
      <div class="auto-grid auto-grid--sm">
        <label class="field">Tap number <input name="tapNumber" type="number" min="1" max="1000000" required /></label>
        <label class="field">Name <input name="name" maxlength="120" placeholder="Optional" /></label>
        <label class="field">Public display
          <select name="enabled">
            <option value="true" selected>Enabled</option>
            <option value="false">Disabled</option>
          </select>
        </label>
        <label class="field">Gas type <input name="gasType" maxlength="64" placeholder="Optional" /></label>
        <label class="field">Serving pressure (kPa) <input name="servingPressureKpa" type="number" min="0" step="any" /></label>
        <label class="field">Line length (mm) <input name="lineLengthMm" type="number" min="0" step="1" /></label>
        <label class="field">Line diameter (mm) <input name="lineDiameterMm" type="number" min="0" step="any" /></label>
      </div>
      <label class="field">Notes <textarea name="notes" maxlength="2048" rows="4"></textarea></label>
      <div class="form-actions"><button class="button button--primary" type="submit">Create Tap</button><a class="button button--secondary" href="/admin/taps">Cancel</a></div>
    </form>
  </section>
</main>
