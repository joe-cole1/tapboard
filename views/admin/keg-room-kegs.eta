<% layout("/layouts/admin", { page: it.page }) %>
<%~ include("/partials/admin-nav", { page: it.page, nav: it.nav }) %>
<main id="main-content" class="admin-page">
  <%~ include("/partials/page-header", {
    title: "Physical Kegs",
    intro: "Physical Kegs are the inventory layer behind each Filled Keg.",
  }) %>
  <div class="cluster page-actions"><a class="button button--primary button--small" href="<%= it.newKegHref %>">Add a Keg</a></div>
  <%~ include("/partials/tabs", { tabs: it.tabs }) %>
  <%~ include("/partials/admin-messages", { page: it.page }) %>
  <section aria-labelledby="physical-keg-filters">
    <%~ include("/partials/section-heading", {
      id: "physical-keg-filters",
      title: "Physical inventory",
      intro: `${it.pagination.total} Keg${it.pagination.total === 1 ? "" : "s"}`,
    }) %>
    <%~ include("/partials/filter-form", it.filter) %>
  </section>
  <section aria-labelledby="fill-history">
  <%~ include("/partials/section-heading", {
    id: "fill-history",
    title: "Fill history",
    intro: "Recent Filled Keg records remain visible from their physical inventory.",
  }) %>
    <% if (it.kegs.length === 0) { %><p class="muted">No physical Kegs are configured.</p><% } else { %>
        <table class="table table--wide table--library">
          <caption class="sr-only">Physical Keg inventory</caption>
          <thead>
            <tr>
              <th scope="col">Physical Keg</th>
              <th scope="col">Current fill</th>
              <th scope="col">Capacity</th>
              <th scope="col">Tare</th>
              <th scope="col">Status</th>
              <th scope="col">Fill history</th>
              <th scope="col">Action</th>
            </tr>
          </thead>
          <tbody>
            <% for (const keg of it.kegs) { %>
              <tr>
                <th scope="row">
                  <div class="library-cell">
                    <div class="library-cell__preview" aria-hidden="true"><%~ include("/partials/fill-graphic", { tap: keg.vessel }) %></div>
                    <a class="library-cell__name"
                      href="/admin/keg-room/kegs/<%= keg.id %>">Keg <%= keg.kegNumber %><% if (keg.label) { %> —
                      <%= keg.label %><% } %></a><span class="library-cell__type">Physical inventory</span></div>
                </th>
                <td data-label="Current fill"><% if (keg.currentFillRecord) { %><a
                  href="/admin/keg-room/fills/<%= keg.currentFillRecord.id %>"><%= keg.currentFillRecord.beverageName %></a><% } else { %><span
                  class="muted">None</span><% } %></td>
                <td data-label="Capacity"><%= keg.capacityLabel %></td>
                <td data-label="Tare"><%= keg.tareLabel %></td>
                <td data-label="Status"><%~ include("/partials/status-badge", keg.badge) %></td>
                <td data-label="Fill history">
                  <% if (keg.recentFillRecord) { %>
                    <a href="/admin/keg-room/fills/<%= keg.recentFillRecord.id %>"><%= keg.fillCountLabel %></a>
                  <% } else { %>
                    <span class="muted">No fills recorded</span>
                  <% } %>
                </td>
                <td><a class="button button--secondary button--small"
                  href="/admin/keg-room/kegs/<%= keg.id %>">Open<span class="sr-only"> Keg
                  <%= keg.kegNumber %><% if (keg.label) { %> — <%= keg.label %><% } %></span></a></td>
              </tr>
            <% } %>
          </tbody>
        </table>
    <% } %>
  </section>
  <% if (it.pageNavigation) { %>
    <%~ include("/partials/pagination", it.pageNavigation) %>
  <% } %>
</main>
