<% layout("/layouts/admin", { page: it.page }) %>
<%~ include("/partials/admin-nav", { page: it.page, nav: it.nav }) %>
<main id="main-content" class="admin-page">
  <%~ include("/partials/page-header", {
    title: "Taps",
    intro: "A compact view of serving positions, assignments, and current health.",
  }) %>
  <%~ include("/partials/admin-messages", { page: it.page }) %>

  <%~ include("/partials/section-heading", {
    id: "tap-list-heading",
    title: "Tap list",
    intro: `${it.pagination.total} tap${it.pagination.total === 1 ? "" : "s"}`,
    actions: [{ label: "Add Tap", href: "/admin/taps/new", primary: true }],
  }) %>

  <form class="form admin-search" method="get" action="/admin/taps" role="search">
    <label for="tap-search">Search by tap number, name, assignment, or keg</label>
    <div class="admin-search__controls">
      <input id="tap-search" name="q" type="search" value="<%= it.query %>" maxlength="80" />
      <label class="sr-only" for="tap-state">Tap state</label>
      <select id="tap-state" name="state">
        <% for (const state of ["all", "assigned", "unassigned", "disabled", "retired"]) { %>
          <option value="<%= state %>"<% if (it.state === state) { %> selected<% } %>><%= state[0].toUpperCase() + state.slice(1) %></option>
        <% } %>
      </select>
      <button class="button button--primary button--small" type="submit">Filter</button>
      <% if (it.query || it.state !== "all") { %><a class="button button--secondary button--small" href="/admin/taps">Clear</a><% } %>
    </div>
  </form>

  <% if (it.taps.length === 0) { %>
    <%~ include("/partials/empty-state", { ...it.empty, id: "tap-empty-heading" }) %>
  <% } else { %>
      <table class="table table--wide table--library" aria-label="Taps">
        <caption class="sr-only">Tap assignments and health</caption>
        <thead><tr><th scope="col">Tap</th><th scope="col">Assignment</th><th scope="col">Remaining</th><th scope="col">Health</th><th scope="col">Status</th><th scope="col">Action</th></tr></thead>
        <tbody>
          <% for (const tap of it.taps) { %>
            <tr data-tap-id="<%= tap.id %>">
              <th scope="row"><div class="library-cell">
                <% if (tap.vessel) { %>
                  <div class="library-cell__preview"><%~ include("/partials/fill-graphic", { tap: tap.vessel }) %></div>
                  <% } else { %>
                  <div class="library-cell__preview" aria-hidden="true"></div>
                <% } %>
                <a class="library-cell__name" href="/admin/taps/<%= tap.id %>">Tap <%= tap.tapNumber %><% if (tap.name) { %> — <%= tap.name %><% } else { %> — Unnamed Tap<% } %></a>
                <span class="library-cell__type"><%= tap.previewLabel %></span>
              </div></th>
              <td data-label="Assignment"><% if (tap.assignment) { %><a
                href="/admin/keg-room/fills/<%= tap.assignment.fillId %>"><%= tap.assignmentLabel %></a><% if (tap.assignment.kegId) { %><span
                class="muted"> · <a href="/admin/keg-room/kegs/<%= tap.assignment.kegId %>">Keg
                <%= tap.assignment.kegNumber %><% if (tap.assignment.kegLabel) { %> —
                <%= tap.assignment.kegLabel %><% } %></a></span><% } %><% } else { %>Unassigned<% } %></td>
              <td data-label="Remaining"><%= tap.remaining %></td>
              <td data-label="Health"><%~ include("/partials/status-badge", tap.healthBadge) %></td>
              <td data-label="Status"><%~ include("/partials/status-badge", tap.statusBadge) %></td>
              <td><a class="button button--secondary button--small"
                href="/admin/taps/<%= tap.id %>">Open<span class="sr-only"> Tap
                <%= tap.tapNumber %><% if (tap.name) { %> — <%= tap.name %><% } else { %> — Unnamed
                Tap<% } %></span></a></td>
            </tr>
          <% } %>
        </tbody>
      </table>
    <% if (it.pageNavigation) { %>
      <%~ include("/partials/pagination", it.pageNavigation) %>
    <% } %>
  <% } %>
</main>
