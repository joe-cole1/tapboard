<% layout("/layouts/admin", { page: it.page }) %>
<%~ include("/partials/admin-nav", { page: it.page, nav: it.nav }) %>
<main id="main-content" class="admin-page">
  <%~ include("/partials/page-header", {
    title: "Page not found",
    intro: "The Admin page you requested does not exist.",
  }) %>
  <%~ include("/partials/empty-state", {
    id: "admin-not-found-heading",
    title: "Nothing to show here",
    text: "Use the Admin navigation or return to the Overview.",
    actions: [{ label: "Back to Overview", href: "/admin/overview" }],
  }) %>
</main>
