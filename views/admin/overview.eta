<% layout("/layouts/admin", { page: it.page }) %>
<%~ include("/partials/admin-nav", { page: it.page, nav: it.nav }) %>
<main id="main-content" class="admin-page">
  <%~ include("/partials/page-header", {
    title: "Overview",
    intro: "Current service health and the next useful actions.",
  }) %>
  <%~ include("/partials/admin-messages", { page: it.page }) %>

  <section aria-labelledby="quick-actions-heading">
    <%~ include("/partials/section-heading", {
      id: "quick-actions-heading",
      title: "Quick actions",
      eyebrow: "Shortcuts",
    }) %>
    <ul class="auto-grid auto-grid--sm quick-actions__list">
      <% for (const item of it.quickLinks) { %>
        <li><a class="card card--link quick-action" href="<%= item.href %>"><%= item.label %><span aria-hidden="true">→</span></a></li>
      <% } %>
    </ul>
  </section>

  <section class="card card--warning" aria-labelledby="attention-heading">
    <%~ include("/partials/section-heading", {
      id: "attention-heading",
      title: "Health summary",
      eyebrow: "Needs attention",
    }) %>
    <% if (it.health.length === 0) { %>
      <%~ include("/partials/empty-state", { text: "No Tap health warnings are currently reported." }) %>
    <% } else { %>
      <ul class="attention-list">
        <% for (const item of it.health) { %>
          <li>
            <%~ include("/partials/status-badge", item.badge) %>
            <a href="<%= item.href %>"><strong><%= item.tapLabel %></strong><% if (item.tapName) { %> — <%= item.tapName %><% } %></a>
            <% if (item.checksLabel) { %>
              <span class="muted"> · <%= item.checksLabel %></span>
            <% } %>
          </li>
        <% } %>
      </ul>
    <% } %>
  </section>

  <section aria-labelledby="tap-summary-heading">
    <%~ include("/partials/section-heading", {
      id: "tap-summary-heading",
      title: "Taps and current assignments",
      eyebrow: "Live assignments",
      actions: [{ label: "Manage Taps", href: "/admin/taps" }],
    }) %>
    <% if (it.taps.length === 0) { %>
      <%~ include("/partials/empty-state", {
        text: "No Taps are configured yet.",
        link: { label: "Add a Tap", href: "/admin/taps" },
      }) %>
    <% } else { %>
      <table class="table">
        <thead>
          <tr>
            <th scope="col">Tap</th>
            <th scope="col">Assignment</th>
            <th scope="col">Status</th>
            <th scope="col">Public</th>
          </tr>
        </thead>
        <tbody>
          <% for (const tap of it.taps) { %>
            <tr>
              <th scope="row"><a href="<%= tap.href %>"><%= tap.title %></a></th>
              <td data-label="Assignment"><%= tap.assignmentLabel %></td>
              <td data-label="Status"><%~ include("/partials/status-badge", tap.badge) %></td>
              <td data-label="Public"><%= tap.publicLabel %></td>
            </tr>
          <% } %>
        </tbody>
      </table>
    <% } %>
  </section>

  <section aria-labelledby="keg-room-heading">
    <%~ include("/partials/section-heading", {
      id: "keg-room-heading",
      title: "Keg Room",
      eyebrow: "Inventory snapshot",
      actions: [{ label: "Open Keg Room", href: "/admin/keg-room" }],
    }) %>
    <%~ include("/partials/stat-tiles", { tiles: it.kegRoom }) %>
  </section>

  <section aria-labelledby="connectivity-heading">
    <%~ include("/partials/section-heading", {
      id: "connectivity-heading",
      title: "Connectivity and integrations",
      eyebrow: "System status",
      actions: [{ label: "Configure Integrations", href: "/admin/integrations" }],
    }) %>
    <p class="status-line"><%~ include("/partials/status-badge", it.connectivity) %></p>
    <%~ include("/partials/stat-tiles", { tiles: it.integrations }) %>
  </section>

  <section aria-labelledby="counts-heading">
    <%~ include("/partials/section-heading", {
      id: "counts-heading",
      title: "Operational counts",
      eyebrow: "Operational summary",
    }) %>
    <%~ include("/partials/stat-tiles", { tiles: it.metrics }) %>
  </section>

</main>
