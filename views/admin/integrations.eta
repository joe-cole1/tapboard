<% layout("/layouts/admin", { page: it.page }) %>
<%~ include("/partials/admin-nav", { page: it.page, nav: it.nav }) %>
<main id="main-content" class="admin-page">
  <%~ include("/partials/page-header", {
    title: "Integrations",
    intro: "Connect the services that supply beverage data and Tap measurements.",
  }) %>
  <%~ include("/partials/tabs", { tabs: it.tabs }) %>
  <%~ include("/partials/admin-messages", { page: it.page }) %>
  <section class="auto-grid auto-grid--lg" aria-labelledby="integration-resources-heading">
    <h2 id="integration-resources-heading" class="sr-only">Integration resources</h2>
    <article class="card integration-resource-card">
      <%~ include("/partials/section-heading", {
        title: "Brewfather",
        eyebrow: "Beverage source",
        badge: it.brewfather.badge,
      }) %>
      <p><%= it.brewfather.summary %></p>
      <dl class="integration-resource-card__summary">
        <div><dt>Linked beverages</dt><dd><%= it.brewfather.linkedBeverages %></dd></div>
        <div><dt>Import candidates</dt><dd><%= it.brewfather.candidates %></dd></div>
      </dl>
      <a class="button button--secondary button--small" href="/admin/integrations/brewfather">Open Brewfather</a>
    </article>
    <article class="card integration-resource-card">
      <%~ include("/partials/section-heading", {
        title: "Telemetry",
        eyebrow: "Measurement sources",
        badge: it.telemetry.badge,
      }) %>
      <p>Manage source keys and the devices that report Tap measurements.</p>
      <dl class="integration-resource-card__summary">
        <div><dt>Active sources</dt><dd><%= it.telemetry.activeCount %></dd></div>
        <div><dt>Disabled history</dt><dd><%= it.telemetry.disabledCount %></dd></div>
      </dl>
      <a class="button button--secondary button--small" href="/admin/integrations/telemetry">Open Telemetry</a>
    </article>
    <article class="card integration-resource-card">
      <%~ include("/partials/section-heading", {
        title: "Outbound",
        eyebrow: "Delivery destinations",
        badge: it.outbound.badge,
      }) %>
      <% if (it.outbound && it.outbound.available) { %>
        <p>Deliver safe Tapboard events to Home Assistant or an HTTP webhook.</p>
        <dl class="integration-resource-card__summary"><div><dt>Destinations</dt><dd><%= it.outbound.count %></dd></div><div><dt>Required</dt><dd><%= it.outbound.requiredCount %></dd></div></dl>
        <a class="button button--secondary button--small" href="/admin/integrations/outbound">Open outbound delivery</a>
      <% } else { %>
        <p>Outbound delivery is not wired into this application instance.</p>
      <% } %>
    </article>
  </section>
</main>
