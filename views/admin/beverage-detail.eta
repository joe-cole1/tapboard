<% layout("/layouts/admin", { page: it.page }) %>
<%~ include("/partials/admin-nav", { page: it.page, nav: it.nav }) %>
<%
  const bev = it.beverage;
  const linked = it.linked;
  const revisionFields = [{ name: "_csrf", value: it.page.csrfToken }, { name: "updatedAt", value: bev.updatedAt }];
%>
<main id="main-content" class="admin-page">
  <%~ include("/partials/page-header", it.header) %>
  <%~ include("/partials/tabs", { tabs: it.tabs }) %>
  <%~ include("/partials/admin-messages", { page: it.page }) %>

<% if (it.tab === "info") { %>
  <section aria-labelledby="beverage-info-heading">
    <%~ include("/partials/section-heading", {
      id: "beverage-info-heading",
      title: "Info",
    }) %>
    <dl class="key-value-list">
      <div><dt>Source</dt><dd><%= linked ? "Brewfather" : "Custom" %></dd></div>
      <% if (bev.syncState) { %><div><dt>Sync state</dt><dd><%= bev.syncState %></dd></div><% } %>
      <% if (bev.lastSyncedAtLabel) { %><div><dt>Last synced</dt><dd><%= bev.lastSyncedAtLabel %></dd></div><% } %>
      <div><dt>Current use</dt><dd><%= bev.usage.current === 0 ? "Not in use" : `${bev.usage.current} Filled Keg${bev.usage.current === 1 ? "" : "s"}` %></dd></div>
    </dl>
    <% if (!linked) { %>
      <form class="form" <%~ include("/partials/autosave-attributes", it.forms.identity) %>>
        <%~ include("/partials/hidden-fields", { fields: revisionFields }) %>
        <div class="auto-grid auto-grid--sm">
          <label class="field">Name <input name="name" value="<%= bev.name %>" maxlength="160" required /></label>
          <label class="field">Type <select name="beverageType">
          <% for (const type of it.beverageTypes) { %>
            <option value="<%= type.value %>"<% if (bev.beverageType === type.value) { %> selected<% } %>><%= type.label %></option>
          <% } %>
          </select></label>
          <label class="field">Style <input name="style" value="<%= bev.style || "" %>" maxlength="120" /></label>
          <label class="field">ABV (%) <input name="abv" type="number" min="0" max="100" step="0.1" value="<%= bev.abv ?? "" %>" /></label>
          <label class="field">IBU <input name="ibu" type="number" min="0" max="2000" step="0.1" value="<%= bev.ibu ?? "" %>" /></label>
          <label class="field">Original gravity <input name="og" type="number" min="0.5" max="2" step="0.001" value="<%= bev.og ?? "" %>" /></label>
          <label class="field">Final gravity <input name="fg" type="number" min="0.5" max="2" step="0.001" value="<%= bev.fg ?? "" %>" /></label>
          <label class="field">Manual density override <input name="manualDensityOverride" type="number" min="0.5" max="2" step="0.001" value="<%= bev.manualDensityOverride ?? "" %>" /></label>
        </div>
        <div class="form-actions"><button class="button button--primary button--small" type="submit"
          data-autosave-fallback>Save details</button><output class="autosave-status" data-autosave-status
          aria-live="polite"></output></div>
      </form>
    <% } else { %>
      <p class="muted">Brewfather supplies these values. Change any of them for this beverage on <a href="/admin/beverages/<%= bev.id %>/presentation">Presentation</a>.</p>
      <dl class="key-value-list">
        <div><dt>Type and style</dt><dd><%= bev.beverageTypeLabel %><% if (bev.style) { %> · <%= bev.style %><% } %></dd></div>
        <div><dt>ABV</dt><dd><%= bev.abv === null ? "—" : `${bev.abv}%` %></dd></div>
        <div><dt>IBU</dt><dd><%= bev.ibu ?? "—" %></dd></div>
        <div><dt>Original gravity</dt><dd><%= bev.og ?? "—" %></dd></div>
        <div><dt>Final gravity</dt><dd><%= bev.fg ?? "—" %></dd></div>
        <div><dt>SRM</dt><dd><%= bev.srm ?? "—" %></dd></div>
      </dl>
    <% } %>
  </section>
  <% if (linked) { %>
    <section aria-labelledby="brewfather-link-heading">
      <%~ include("/partials/section-heading", {
        id: "brewfather-link-heading",
        title: "Brewfather link",
        intro: "Unlinking keeps this beverage, its Fills and its current values as a Custom beverage. Brewfather stops updating it.",
      }) %>
      <form class="form" action="/admin/beverages/<%= bev.id %>/unlink" method="post">
        <%~ include("/partials/hidden-fields", { fields: revisionFields }) %>
        <button class="button button--secondary button--small" type="submit">Unlink and keep as custom</button></form>
    </section>
  <% } %>

<% } else if (it.tab === "presentation") { %>
  <section aria-labelledby="presentation-heading">
    <%~ include("/partials/section-heading", {
      id: "presentation-heading",
      title: "Presentation",
      intro: linked ? "Brewfather supplies each value. Override one for this beverage, or reset it to follow Brewfather again." : "How this beverage appears on the display.",
    }) %>
    <% if (!linked) { %>
      <form class="form" <%~ include("/partials/autosave-attributes", it.forms.presentation) %>>
        <%~ include("/partials/hidden-fields", { fields: revisionFields }) %>
        <%~ include("/partials/fill-glass-picker", { label: "Fill Glass", name: "fillGlass", id: `custom-fill-glass-${bev.id}`, selected: bev.fillGlass || "", options: it.fillGlassOptions || [] }) %>
        <label class="field">Description <textarea name="description" maxlength="4000" rows="4"><%= bev.description || "" %></textarea></label>
        <div class="form-actions"><button class="button button--primary button--small" type="submit"
          data-autosave-fallback>Save presentation</button><output class="autosave-status" data-autosave-status
          aria-live="polite"></output></div>
      </form>
    <% } else if (bev.source && bev.overrides) { %>
      <form class="form"
        <%~ include("/partials/autosave-attributes", it.forms.overrides) %>>
        <%~ include("/partials/hidden-fields", { fields: revisionFields }) %>
        <% const o = bev.overrides; %>
        <div class="auto-grid auto-grid--lg source-control-grid">
          <fieldset class="fieldset">
            <legend>Name</legend>
            <p><strong>Source:</strong> <%= bev.source.name %></p>
            <p><strong>Effective:</strong> <%= bev.name %></p>
            <%~ include("/partials/override-mode",
              it.overrideModes.name) %><label class="field">Override value <input name="name"
              value="<%= o.name || bev.name %>" maxlength="160" /></label></fieldset>
          <fieldset class="fieldset">
            <legend>Type</legend>
            <p><strong>Source:</strong> <%= bev.source.beverageTypeLabel %></p>
            <p><strong>Effective:</strong> <%= bev.beverageTypeLabel %></p>
            <%~ include("/partials/override-mode", it.overrideModes.beverageType) %><label class="field">Override value <select name="beverageType">
            <% for (const type of it.beverageTypes) { %>
              <option value="<%= type.value %>"<% if ((o.beverageType || bev.beverageType) === type.value) { %> selected<% } %>><%= type.label %></option>
            <% } %>
            </select></label></fieldset>
          <fieldset class="fieldset">
            <legend>Style</legend>
            <p><strong>Source:</strong> <%= bev.source.style || "—" %></p>
            <p><strong>Effective:</strong> <%= bev.style || "—" %></p>
            <%~ include("/partials/override-mode", it.overrideModes.style) %><label class="field">Override value <input name="style"
              value="<%= o.style || bev.style || "" %>" maxlength="120" /></label></fieldset>
          <fieldset class="fieldset">
            <legend>ABV</legend>
            <p><strong>Source:</strong> <%= bev.source.abv === null ? "—" : `${bev.source.abv}%` %></p>
            <p><strong>Effective:</strong> <%= bev.abv === null ? "—" : `${bev.abv}%` %></p>
            <%~ include("/partials/override-mode", it.overrideModes.abv) %><label class="field">Override value <input name="abv" type="number" min="0" max="100"
              step="0.1" value="<%= o.abv ?? bev.abv ?? "" %>" /></label></fieldset>
          <fieldset class="fieldset">
            <legend>IBU</legend>
            <p><strong>Source:</strong> <%= bev.source.ibu ?? "—" %></p>
            <p><strong>Effective:</strong> <%= bev.ibu ?? "—" %></p>
            <%~ include("/partials/override-mode", it.overrideModes.ibu) %><label class="field">Override value <input name="ibu" type="number" min="0" max="2000"
              step="0.1" value="<%= o.ibu ?? bev.ibu ?? "" %>" /></label></fieldset>
          <fieldset class="fieldset">
            <legend>Original gravity</legend>
            <p><strong>Source:</strong> <%= bev.source.og ?? "—" %></p>
            <p><strong>Effective:</strong> <%= bev.og ?? "—" %></p>
            <%~ include("/partials/override-mode", it.overrideModes.og) %><label class="field">Override value <input name="og" type="number" min="0.5" max="2"
              step="0.001" value="<%= o.og ?? bev.og ?? "" %>" /></label></fieldset>
          <fieldset class="fieldset">
            <legend>Final gravity</legend>
            <p><strong>Source:</strong> <%= bev.source.fg ?? "—" %></p>
            <p><strong>Effective:</strong> <%= bev.fg ?? "—" %></p>
            <%~ include("/partials/override-mode", it.overrideModes.fg) %><label class="field">Override value <input name="fg" type="number" min="0.5" max="2"
              step="0.001" value="<%= o.fg ?? bev.fg ?? "" %>" /></label></fieldset>
          <fieldset class="fieldset">
            <legend>Description</legend>
            <p><strong>Source:</strong> <%= bev.source.description || "—" %></p>
            <p><strong>Effective:</strong> <%= bev.description || "—" %></p>
            <%~ include("/partials/override-mode", it.overrideModes.description) %><label class="field">Override value <textarea name="description"
              maxlength="4000"><%= o.description || bev.description || "" %></textarea></label></fieldset>
          <fieldset class="fieldset">
            <legend>Fill Glass</legend>
            <p><strong>Source:</strong> Style suggestion</p>
            <p><strong>Effective:</strong> <%= bev.fillGlass || "Style suggestion" %></p>
            <%~ include("/partials/override-mode", it.overrideModes.fillGlass) %>
            <%~ include("/partials/fill-glass-picker", { label: "Override vessel", name: "fillGlass",
              id: `source-fill-glass-${bev.id}`, selected: o.overrideFillGlassPresent ? (o.fillGlass || "") : "",
              options: it.fillGlassOptions || [] }) %>
          </fieldset>
          <fieldset class="fieldset">
            <legend>Manual density</legend>
            <p><strong>Source:</strong> Not supplied</p>
            <p><strong>Effective:</strong> <%= bev.manualDensityOverride ?? "Fallback/FG derived" %></p>
            <%~ include("/partials/override-mode", it.overrideModes.manualDensityOverride) %><label class="field">Override value <input
              name="manualDensityOverride" type="number" min="0.5" max="2" step="0.001"
              value="<%= o.manualDensityOverride ?? bev.manualDensityOverride ?? "" %>" /></label></fieldset>
        </div>
        <div class="form-actions"><button class="button button--primary button--small" type="submit"
          data-autosave-fallback>Save Brewfather presentation</button><output class="autosave-status"
          data-autosave-status aria-live="polite"></output></div>
      </form>
    <% } %>
  </section>

  <section aria-labelledby="display-colour-heading">
    <%~ include("/partials/section-heading", {
      id: "display-colour-heading",
      title: "Display colour",
      intro: it.colourIntro,
    }) %>
    <%~ include("/partials/display-colour-picker", { picker: it.colourPicker, mode: "live", id: `colour-${bev.id}`,
      action: `/admin/beverages/${bev.id}/${linked ? "presentation" : "update"}`, resource: `beverage:${bev.id}`,
      revision: bev.updatedAt, csrfToken: it.page.csrfToken }) %>
  </section>

<% } else if (it.tab === "usage") { %>
  <section aria-labelledby="fill-heading">
    <%~ include("/partials/section-heading", {
      id: "fill-heading",
      title: "Current usage",
      intro: `${bev.usage.total} fill record${bev.usage.total === 1 ? "" : "s"} linked to this beverage.`,
      actions: [{ label: "Keg Room", href: "/admin/keg-room" }],
    }) %>
    <% if ((it.currentFills || []).length > 0) { %>
      <table class="table">
        <caption class="sr-only">Current Filled Kegs</caption>
        <thead>
          <tr>
            <th scope="col">Filled Keg</th>
            <th scope="col">State</th>
            <th scope="col">Tap</th>
            <th scope="col">Fill date</th>
          </tr>
        </thead>
        <tbody>
          <% for (const fill of it.currentFills) { %>
            <tr>
              <th scope="row"><a href="/admin/keg-room/fills/<%= fill.id %>">Keg
                <%= fill.kegNumber %><% if (fill.kegLabel) { %> — <%= fill.kegLabel %><% } %></a><br /><a class="muted"
                href="/admin/keg-room/kegs/<%= fill.kegId %>">Physical Keg detail</a></th>
              <td data-label="State"><%~ include("/partials/status-badge", fill.badge) %></td>
              <td data-label="Tap"><% if (fill.tapId) { %><a href="/admin/taps/<%= fill.tapId %>">Tap <%= fill.tapNumber %></a><% } else { %>—<% } %></td>
              <td data-label="Fill date"><%= fill.fillDate %></td>
            </tr>
          <% } %>
        </tbody>
      </table>
    <% } else { %><p class="muted">No current Filled Kegs use this beverage.</p><% } %>
  </section>
  <section aria-labelledby="new-fill-heading">
    <%~ include("/partials/section-heading", {
      id: "new-fill-heading",
      title: "Fill a Keg",
    }) %>
    <% if ((it.availableKegs || []).length === 0) { %><p class="muted">No empty active kegs are available for a new fill.</p><% } else { %>
      <form class="form" action="/admin/beverages/<%= bev.id %>/create-fill" method="post">
        <%~ include("/partials/hidden-fields", { fields: revisionFields }) %>
        <div class="auto-grid auto-grid--sm"><label class="field">Physical keg <select name="kegId" required>
          <option value="">Choose keg</option>
          <% for (const keg of it.availableKegs) { %>
            <option value="<%= keg.id %>">Keg <%= keg.kegNumber %><% if (keg.label) { %> — <%= keg.label %><% } %></option>
          <% } %>
          </select></label><label class="field">Fill date <input name="fillDate" type="date" /></label></div>
        <button class="button button--primary button--small" type="submit">Create fill</button></form>
    <% } %>
  </section>

<% } else if (it.tab === "recipe") { %>
  <% if (bev.recipeImport === "imported" || bev.recipeImport === "source") { %>
    <section aria-labelledby="recipe-import-heading">
      <%~ include("/partials/section-heading", {
        id: "recipe-import-heading",
        title: it.recipeImportHeading.title,
        intro: it.recipeImportHeading.intro,
      }) %>
      <% for (const recipe of (bev.guidance?.sourceRecipes || [])) { %>
        <article class="source-recipe">
          <h3><%= recipe.provenance?.label || "Imported recipe" %></h3>
          <ul>
            <% for (const ingredient of recipe.ingredients) { %>
              <li><%= ingredient.name %><% if (ingredient.amount !== null) { %> — <%= ingredient.amount %><% } %><% if (ingredient.unit) { %> <%= ingredient.unit %><% } %></li>
            <% } %>
          </ul>
        </article>
      <% } %>
      </section>
  <% } else if (bev.recipeImport === "available") { %>
    <section aria-labelledby="recipe-import-heading">
      <%~ include("/partials/section-heading", {
        id: "recipe-import-heading",
        title: "Import recipe file",
        intro: `A Brewfather batch or recipe JSON export, a BeerJSON file or a BeerXML file
          (in BeerSmith: File → Export → BeerXML), up to about 1 MiB of text and one recipe per file.
          Tapboard keeps a cleaned copy for the recipe sheet and flavor guidance. The import is permanent.`,
      }) %>
      <form class="form" action="/admin/beverages/<%= bev.id %>/recipe-import" method="post" data-recipe-import>
        <input type="hidden" name="_csrf" value="<%= it.page.csrfToken %>" />
        <label class="field" hidden data-recipe-file-picker>Recipe file <input type="file" accept=".json,.xml,application/json,application/xml,text/xml" data-recipe-file /></label>
        <label class="field">Recipe file contents <textarea name="recipeFile" rows="10" spellcheck="false" required></textarea></label>
        <p class="muted" data-recipe-file-status aria-live="polite"></p>
        <button class="button button--secondary button--small" type="submit">Import recipe</button>
      </form>
    </section>
  <% } else if (bev.recipeImport === "unavailable") { %>
    <section aria-labelledby="recipe-import-heading">
    <%~ include("/partials/section-heading", {
      id: "recipe-import-heading",
      title: "Import recipe file",
      intro: "This beverage has an editable custom recipe, so a recipe file can't be imported. Remove the custom recipe below to import a file instead.",
    }) %>
    </section>
  <% } %>
  <% if (!linked) { %>
    <section aria-labelledby="recipe-heading">
      <%~ include("/partials/section-heading", {
        id: "recipe-heading",
        title: "Custom recipe",
        intro: "Ingredients and process notes as one recipe object.",
      }) %>
      <p class="muted">Use the keys <code>notes</code>, <code>ingredients</code> and <code>steps</code>. Leave it blank (or enter <code>null</code>) to remove the custom recipe.</p>
      <form class="form" <%~ include("/partials/autosave-attributes", it.forms.recipe) %>>
        <%~ include("/partials/hidden-fields", { fields: revisionFields }) %>
        <label class="field">Recipe JSON <textarea name="recipeJson" rows="16" spellcheck="false"><%= bev.customRecipeJson %></textarea></label>
        <div class="form-actions"><button class="button button--primary button--small" type="submit"
          data-autosave-fallback>Save custom recipe</button><output class="autosave-status" data-autosave-status
          aria-live="polite"></output></div>
      </form>
    </section>
  <% } else if (bev.guidance && bev.guidance.sourceRecipes.length > 0) { %>
    <section aria-labelledby="source-recipe-heading">
    <%~ include("/partials/section-heading", {
      id: "source-recipe-heading",
      title: "Source recipe",
      intro: "Read-only, from the linked Brewfather batch.",
    }) %>
    <% for (const recipe of bev.guidance.sourceRecipes) { %>
      <article class="source-recipe">
        <h3><%= recipe.provenance?.label || "Source recipe" %></h3>
        <p class="muted"><%= recipe.status || "available" %></p>
        <% if (recipe.notes) { %>
          <p><%= recipe.notes %></p>
        <% } %>
        <ul>
          <% for (const ingredient of recipe.ingredients) { %>
            <li><%= ingredient.name %><% if (ingredient.amount !== null) { %> — <%= ingredient.amount %><% } %><% if (ingredient.unit) { %> <%= ingredient.unit %><% } %></li>
          <% } %>
        </ul>
      </article>
    <% } %>
    </section>
  <% } else { %>
    <section aria-labelledby="source-recipe-heading">
    <%~ include("/partials/section-heading", {
      id: "source-recipe-heading",
      title: "Source recipe",
    }) %>
    <p class="muted">The linked Brewfather batch has no recipe to show yet.</p></section>
  <% } %>

<% } else if (it.tab === "sensory") { %>
  <section aria-labelledby="sensory-heading">
    <%~ include("/partials/section-heading", {
      id: "sensory-heading",
      title: "Sensory guidance",
      intro: "Derived from the recipe, unless an override below sets an axis.",
    }) %>
    <% if (bev.guidance) { %>
      <dl class="key-value-list">
        <% for (const axis of it.sensoryAxes) { const result = bev.guidance.sensory[axis.key]; %>
          <div>
            <dt><%= axis.label %></dt>
            <dd><%= result.value === null ? "Unavailable" : `${Number(result.value.toFixed(1))} / 5` %> ·
              <%= result.sourceLabel %><% if (result.evidence) { %> · <%= result.evidence %><% } %></dd>
          </div>
        <% } %>
      </dl>
      <% } else { %>
      <p class="muted">Guidance is unavailable until a compatible source or manual override is present.</p>
    <% } %>
    <% if (bev.guidance?.brewingEnrichmentPending) { %><p class="muted">Recipe enrichment is pending. The last saved guidance remains available while the linked batch is refreshed.</p><% } %>
  </section>
  <section aria-labelledby="sensory-overrides-heading">
    <%~ include("/partials/section-heading", {
      id: "sensory-overrides-heading",
      title: "Overrides",
      intro: "Manual values from 0 to 10. Leave an axis blank to use the derived value.",
    }) %>
    <form class="form" <%~ include("/partials/autosave-attributes", it.forms.sensory) %>>
      <%~ include("/partials/hidden-fields", { fields: revisionFields }) %>
      <div class="auto-grid auto-grid--sm"><% for (const axis of it.sensoryAxes) { %><label
        class="field"><%= axis.label %><input name="<%= axis.key %>" type="number" min="0" max="10" step="0.1"
        value="<%= bev.sensoryOverrides?.[axis.key] ?? "" %>" /></label><% } %></div>
      <div class="form-actions"><button class="button button--primary button--small" type="submit"
        data-autosave-fallback>Save sensory overrides</button><output class="autosave-status" data-autosave-status
        aria-live="polite"></output></div>
    </form>
  </section>
  <% if (bev.guidance?.flavorDetails) { const details = bev.guidance.flavorDetails; %>
    <section aria-labelledby="sensory-why-heading">
      <%~ include("/partials/section-heading", {
        id: "sensory-why-heading",
        title: "Why these estimates?",
        intro: `Model ${details.modelVersion || "Unavailable"} · Catalog ${details.catalogVersion || "Unavailable"}.
          Versioned heuristics; ingredient support does not establish scientific validation.`,
      }) %>
      <h3>Selected brewing inputs</h3>
      <table class="table">
        <caption class="sr-only">Selected brewing inputs</caption>
        <thead>
          <tr>
            <th scope="col">Input</th>
            <th scope="col">Selected value</th>
            <th scope="col">Source</th>
          </tr>
        </thead>
        <tbody>
          <% for (const scalar of details.scalars) { %>
            <tr>
              <th scope="row"><%= scalar.key %></th>
              <td data-label="Selected value"><%= scalar.value === null ? "Unavailable" : Number(scalar.value.toPrecision(5)) %> <%= scalar.value === null ? "" : scalar.unit || "" %></td>
              <td data-label="Source"><%= scalar.provenanceLabel %><% if (scalar.sourcePath) { %><br
                /><small><%= scalar.sourcePath %></small><% } %><% if (scalar.limitations.length) { %><br
                /><small><%= scalar.limitations.join("; ") %></small><% } %></td>
            </tr>
          <% } %>
        </tbody>
      </table>
      <h3>Ingredient coverage</h3>
      <ul>
        <% for (const group of details.coverage) { %>
          <li><%= group.key %>:
            <%= group.present ? `${group.resolvedCount ?? 0} recognized of ${group.acceptedCount ?? 0} accepted` : "Collection not supplied" %>
            · <%= group.complete ? "Complete collection" : "Incomplete collection" %><% if (group.classifiedFraction !== null) { %>
            · <%= Math.round(group.classifiedFraction * 100) %>% classified by eligible mass<% } %></li>
        <% } %>
      </ul>
      <h3>Axis support and limitations</h3>
      <dl class="key-value-list">
        <% for (const axis of details.axes) { %>
          <div>
            <dt><%= it.axisLabels[axis.key] || axis.key %></dt>
            <dd><%= axis.support || "Unavailable" %><% if (axis.reasonsLabel) { %> ·
              <%= axis.reasonsLabel %><% } %><% if (axis.limitationsLabel) { %><br
              /><small><%= axis.limitationsLabel %></small><% } %></dd>
          </div>
        <% } %>
      </dl>
      <% if (details.catalogGaps.length) { %>
        <h3>Ingredients not in the flavor catalog</h3>
        <p class="muted">Generic or no flavor words are used for these. A maker's data sheet lets a reviewed entry replace them.</p>
        <ul>
          <% for (const gap of details.catalogGaps) { %>
            <li><%= gap %></li>
          <% } %>
        </ul>
      <% } %>
      <% if (details.diagnostics.length) { %><h3>Input diagnostics</h3><ul><% for (const diagnostic of details.diagnostics) { %><li><%= diagnostic %></li><% } %></ul><% } %>
    </section>
  <% } %>

<% } else { %>
  <section class="card card--danger" aria-labelledby="delete-heading">
    <%~ include("/partials/section-heading", {
      id: "delete-heading",
      title: "Permanent deletion",
      intro: "This removes the beverage and its dependent records. The confirmation must exactly match the current effective name.",
    }) %>
    <%~ include("/partials/permanent-action", { id: `beverage-delete-${bev.id}`, blockers: [],
      impact: bev.deletionImpact, action: `/admin/beverages/${bev.id}/delete`, hiddenFields: revisionFields,
      confirmation: { field: "confirmationName", value: bev.name }, reason: true,
      buttonLabel: "Permanently delete beverage" }) %>
  </section>
<% } %>
</main>
