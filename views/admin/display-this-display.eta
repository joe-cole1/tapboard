<% layout("/layouts/admin", { page: it.page }) %>
<%~ include("/partials/admin-nav", { page: it.page, nav: it.nav }) %>
<main id="main-content" class="admin-page">
  <%~ include("/partials/page-header", {
    title: "This display",
    intro: "These choices are stored only in this browser. \"Use default\" follows future changes to the",
    introLink: { label: "default theme", href: "/admin/display/shared" },
  }) %>
  <%~ include("/partials/tabs", { tabs: it.tabs }) %>
  <%~ include("/partials/admin-messages", { page: it.page }) %>
  <section aria-labelledby="local-settings-heading">
    <h2 id="local-settings-heading">Local overrides</h2>
    <form class="form display-settings-form" data-display-preferences action="/admin/display/this-display" method="post" hidden>
      <%~ include("/partials/display-theme-cards", { options: it.themeOptions, selected: "", inherit: true }) %>
      <%~ include("/partials/display-font-cards", { options: it.fontOptions, selected: "", inherit: true }) %>
      <%~ include("/partials/display-accent-picker", { options: it.accentOptions, selected: "", inherit: true }) %>
      <label class="field">Units <select name="unitSystem"><option value="">Use default</option><option value="us">US customary</option><option value="metric">Metric</option></select></label>
      <label class="field">Serving temperature <select name="showServingTemperature"><option value="">Use default</option><option value="true">Shown</option><option value="false">Hidden</option></select></label>
      <label class="field">More than six Taps <select name="layoutMode"><option value="">Use default</option><option value="scroll">Responsive and scroll</option><option value="rotation">Automatic rotation</option></select></label>
      <div class="form-actions"><button class="button button--secondary" type="button" data-reset-preferences>Reset to default theme</button></div>
    </form>
    <p data-display-preference-status role="status" aria-live="polite"></p>
    <noscript><p class="warning">JavaScript is required to save browser-local overrides. The public display remains fully usable without JavaScript.</p></noscript>
  </section>
</main>
<script type="module" src="/assets/js/admin-display.js"></script>
