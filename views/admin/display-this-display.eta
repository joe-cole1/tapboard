<% layout("/layouts/admin", { page: it.page }) %>
<%~ include("/partials/admin-nav", { page: it.page, items: it.navItems || [] }) %>
<main id="main-content">
  <header class="page-header"><p class="eyebrow"><a href="/admin/display">Display</a> / This display</p><h1>This display</h1><p>These choices are stored only in this browser. "Use default" follows future changes to the <a href="/admin/display/shared">default theme</a>.</p></header>
  <%~ include("/partials/admin-messages", { page: it.page }) %>
  <section aria-labelledby="local-settings-heading">
    <h2 id="local-settings-heading">Local overrides</h2>
    <form class="display-settings-form" data-display-preferences action="/admin/display/this-display" method="post" hidden>
      <%~ include("/partials/display-theme-cards", { options: it.themeOptions, selected: "", inherit: true }) %>
      <%~ include("/partials/display-font-cards", { options: it.fontOptions, selected: "", inherit: true }) %>
      <%~ include("/partials/display-accent-picker", { options: it.accentOptions, selected: "", inherit: true }) %>
      <label>Units <select name="unitSystem"><option value="">Use default</option><option value="us">US customary</option><option value="metric">Metric</option></select></label>
      <label>Serving temperature <select name="showServingTemperature"><option value="">Use default</option><option value="true">Shown</option><option value="false">Hidden</option></select></label>
      <label>More than six Taps <select name="layoutMode"><option value="">Use default</option><option value="scroll">Responsive and scroll</option><option value="rotation">Automatic rotation</option></select></label>
      <div class="form-actions"><button class="button button--secondary" type="button" data-reset-preferences>Reset to default theme</button></div>
    </form>
    <p data-display-preference-status role="status" aria-live="polite"></p>
    <noscript><p class="warning">JavaScript is required to save browser-local overrides. The public display remains fully usable without JavaScript.</p></noscript>
  </section>
</main>
<script type="module" src="/assets/js/admin-display.js"></script>
