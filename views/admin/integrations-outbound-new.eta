<% layout("/layouts/admin", { page: it.page }) %>
<%~ include("/partials/admin-nav", { page: it.page, items: it.navItems }) %>
<main id="main-content" class="admin-page">
  <header class="page-header">
    <h1>New outbound destination</h1>
    <p>Create a disabled destination first if you want to verify configuration before delivery begins.</p>
  </header>
  <%~ include("/partials/admin-messages", { page: it.page }) %>
  <% if (!it.available) { %>
    <section class="empty-state"><h2>Outbound delivery is unavailable</h2><p>The application composition has not enabled the outbound service.</p></section>
  <% } else { %>
    <section aria-labelledby="outbound-create-heading">
      <h2 id="outbound-create-heading"><%= it.transport === "webhook" ? "Create webhook destination" : "Create Home Assistant destination" %></h2>
      <%~ include("/admin/integrations-outbound-form", { page: it.page, transport: it.transport, eventFields: it.eventFields, maxHeaderRows: it.maxHeaderRows }) %>
    </section>
  <% } %>
</main>
