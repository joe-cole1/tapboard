<% layout("/layouts/admin", { page: it.page }) %>
<%~ include("/partials/admin-nav", { page: it.page, nav: it.nav }) %>
<main id="main-content" class="admin-page">
  <%~ include("/partials/page-header", {
    title: "New telemetry source",
    intro: "Name the device that will report measurements. Tapboard issues its machine key and shows it once.",
  }) %>
  <%~ include("/partials/admin-messages", { page: it.page }) %>
  <section aria-labelledby="new-telemetry-source-heading">
    <h2 id="new-telemetry-source-heading">Telemetry source</h2>
    <form class="form" action="/admin/integrations/telemetry-sources/create" method="post">
      <input type="hidden" name="_csrf" value="<%= it.page.csrfToken %>" />
      <label class="field">Source name <input name="name" maxlength="120" required /></label>
      <div class="cluster"><button class="button button--primary" type="submit">Create source and show key</button><a class="button button--secondary" href="/admin/integrations/telemetry">Cancel</a></div>
    </form>
  </section>
</main>
