<% layout("/layouts/admin", { page: it.page }) %>
<%~ include("/partials/admin-nav", { page: it.page, nav: it.nav }) %>
<% const workspace = it.workspace || it.page.workspace || { enabled: false, changing: false }; %>
<main id="main-content" class="admin-page">
  <%~ include("/partials/page-header", {
    title: "Admin sessions",
    intro: "Browsers signed in to Admin. Session lifetimes and the PIN are on",
    introLink: { label: "System", href: "/admin/system" },
  }) %>
  <%~ include("/partials/tabs", { tabs: it.tabs }) %>
  <%~ include("/partials/admin-messages", { page: it.page }) %>
  <% if (workspace.enabled) { %><p class="muted">Admin sessions are shared with your real installation.</p><% } %>
  <section aria-labelledby="system-sessions-heading">
    <h2 id="system-sessions-heading" class="sr-only">Signed-in browsers</h2>
    <p>Up to 100 active sessions are shown, including this session first. Revoking a session signs that browser out.</p>
    <div class="stack stack--loose">
      <% for (const session of it.sessions) { %>
        <article class="card" aria-labelledby="session-<%= session.id %>">
          <h3 id="session-<%= session.id %>"><%= session.current ? 'This session' : `Session ${session.id.slice(0, 8)}` %></h3>
          <dl class="key-value-list"><div><dt>Created</dt><dd><time datetime="<%= session.createdAt %>"><%= session.createdAt %></time></dd></div><div><dt>Last used</dt><dd><time datetime="<%= session.lastUsedAt %>"><%= session.lastUsedAt %></time></dd></div><div><dt>Expires</dt><dd><time datetime="<%= session.expiresAt %>"><%= session.expiresAt %></time></dd></div><div><dt>Absolute expiry</dt><dd><time datetime="<%= session.absoluteExpiresAt %>"><%= session.absoluteExpiresAt %></time></dd></div></dl>
          <form action="/admin/logs/sessions/<%= session.id %>/revoke" method="post" class="form system-revoke-form">
            <input type="hidden" name="_csrf" value="<%= it.page.csrfToken %>" />
            <label class="switch"><input class="switch__control" role="switch" type="checkbox" name="confirm" value="revoke" required /> Confirm revocation<%= session.current ? ' of this session' : '' %></label>
            <button type="submit" class="button button--secondary">Revoke <%= session.current ? 'this session' : 'session' %></button>
          </form>
        </article>
      <% } %>
    </div>
  </section>
</main>
