<% layout("/layouts/admin", { page: it.page }) %>
<%~ include("/partials/admin-nav", { page: it.page, items: it.navItems }) %>
<%
  const keg = it.keg;
  const revisionFields = `<input type="hidden" name="_csrf" value="${it.page.csrfToken}" /><input type="hidden" name="updatedAt" value="${keg.updatedAt}" />`;
  const liveForm = (fields) => `action="/admin/kegs/${keg.id}/update" method="post" data-autosave="blur" data-autosave-resource="keg:${keg.id}" data-autosave-revision="updatedAt" data-autosave-fields="${fields}"`;
%>
<main id="main-content" class="admin-page">
  <header class="page-header">
    <div><h1>Keg <%= keg.kegNumber %><% if (keg.label) { %> — <%= keg.label %><% } %></h1></div>
    <span class="badge<%= keg.isActive ? " badge--active" : "" %>"><%= keg.isActive ? "Active" : "Inactive" %></span>
  </header>
  <%~ include("/partials/admin-messages", { page: it.page }) %>

  <section aria-labelledby="keg-details-heading">
    <div class="header-row"><div><h2 id="keg-details-heading">Details</h2></div></div>
    <dl class="key-value-list">
      <div><dt>Current fill</dt><dd><% if (keg.currentFill) { %><a href="/admin/keg-room/fills/<%= keg.currentFill.id %>"><%= keg.currentFill.beverageName %></a> · <%= keg.currentFill.stateLabel %><% } else { %>Empty<% } %></dd></div>
      <div><dt>Last updated</dt><dd><time datetime="<%= keg.updatedAt %>"><%= keg.updatedAtLabel %></time></dd></div>
    </dl>
    <form class="form" <%~ liveForm("label") %>>
      <%~ revisionFields %>
      <label class="field">Label <input name="label" maxlength="120" value="<%= keg.label || "" %>" /></label>
      <div class="form-actions"><button class="button button--primary button--small" type="submit" data-autosave-fallback>Save label</button><output class="autosave-status" data-autosave-status aria-live="polite"></output></div>
    </form>
    <form class="form" <%~ liveForm("kegNumber,capacityMl,isActive") %>>
      <%~ revisionFields %>
      <div class="auto-grid auto-grid--sm">
        <label class="field">Keg number <input name="kegNumber" type="number" min="1" value="<%= keg.kegNumber %>" required /></label>
        <label class="field">Capacity (mL) <input name="capacityMl" type="number" min="1" value="<%= keg.capacityMl %>" required /></label>
        <label class="field">Status <select name="isActive"><option value="true"<% if (keg.isActive) { %> selected<% } %>>Active</option><option value="false"<% if (!keg.isActive) { %> selected<% } %>>Inactive</option></select></label>
      </div>
      <div class="form-actions"><button class="button button--primary button--small" type="submit" data-autosave-fallback>Save details</button><output class="autosave-status" data-autosave-status aria-live="polite"></output></div>
    </form>
  </section>

  <section aria-labelledby="keg-fill-history">
    <div class="header-row"><div><h2 id="keg-fill-history">Fill history</h2></div></div>
    <% if (keg.fillHistory.length === 0) { %><p class="muted">No Filled Kegs recorded.</p><% } else { %>
      <table class="table"><caption class="sr-only">Filled Kegs in this Keg, newest first</caption><thead><tr><th scope="col">Beverage</th><th scope="col">Fill date</th><th scope="col">State</th><th scope="col">Ended</th></tr></thead><tbody><% for (const fill of keg.fillHistory) { %><tr><th scope="row"><a href="/admin/keg-room/fills/<%= fill.id %>"><%= fill.beverageName %></a></th><td data-label="Fill date"><%= fill.fillDate %></td><td data-label="State"><span class="badge badge--<%= fill.state %>"><%= fill.stateLabel %></span></td><td data-label="Ended"><% if (fill.endedAt) { %><time datetime="<%= fill.endedAt %>"><%= fill.endedAtLabel %></time><% } else { %>—<% } %></td></tr><% } %></tbody></table>
    <% } %>
  </section>

  <section aria-labelledby="keg-maintenance-heading">
    <div class="header-row"><div><h2 id="keg-maintenance-heading">Maintenance</h2></div></div>
    <% if (keg.maintenanceHistory.length === 0) { %><p class="muted">No maintenance recorded yet.</p><% } else { %>
      <ul class="compact-list"><% for (const item of keg.maintenanceHistory) { %><li><%= item.maintenanceType %> · <time datetime="<%= item.recordedAt %>"><%= item.recordedAtLabel %></time></li><% } %></ul>
    <% } %>
    <form class="form" action="/admin/kegs/<%= keg.id %>/maintenance" method="post"><input type="hidden" name="_csrf" value="<%= it.page.csrfToken %>" /><div class="auto-grid auto-grid--sm"><label class="field">Type <input name="maintenanceType" maxlength="80" required /></label><label class="field">Notes <textarea name="notes" maxlength="2048" rows="2"></textarea></label></div><button class="button button--secondary button--small" type="submit">Record maintenance</button></form>
  </section>

  <section aria-labelledby="keg-advanced-heading">
    <details class="disclosure">
      <summary id="keg-advanced-heading">Advanced settings<small>Tare weight and its corrections.</small></summary>
      <form class="form" <%~ liveForm("currentTareG,reason") %>>
        <%~ revisionFields %>
        <div class="auto-grid auto-grid--sm">
          <label class="field">Tare (g) <input name="currentTareG" type="number" min="0" step="1" value="<%= keg.currentTareG %>" required /></label>
          <label class="field" for="keg-tare-reason"><span>Correction reason</span><input id="keg-tare-reason" name="reason" maxlength="255" aria-describedby="keg-tare-reason-help" /><small id="keg-tare-reason-help" class="field__help">Recorded with the next tare change.</small></label>
        </div>
        <div class="form-actions"><button class="button button--primary button--small" type="submit" data-autosave-fallback>Save tare</button><output class="autosave-status" data-autosave-status aria-live="polite"></output></div>
      </form>
      <h3>Tare corrections</h3>
      <% if (keg.tareHistory.length === 0) { %><p class="muted">No tare corrections recorded.</p><% } else { %>
        <ul class="compact-list"><% for (const item of keg.tareHistory) { %><li><%= item.previousTareG === null ? "Initial" : `${item.previousTareG} g` %> → <%= item.newTareG %> g · <time datetime="<%= item.recordedAt %>"><%= item.recordedAtLabel %></time><% if (item.reason) { %> · <%= item.reason %><% } %></li><% } %></ul>
      <% } %>
    </details>
  </section>

  <section class="card card--danger" aria-labelledby="delete-keg"><div class="header-row"><div><h2 id="delete-keg">Permanent deletion</h2><p class="muted">Deletion removes this Keg and its tare and maintenance records.</p></div></div><div class="field confirmation-copy" data-copy-group><label for="keg-confirmation-value-<%= keg.id %>">Exact confirmation value</label><div class="confirmation-copy__row"><input id="keg-confirmation-value-<%= keg.id %>" readonly value="<%= keg.confirmationLabel %>" /><button class="button button--secondary button--small" type="button" data-copy-target="keg-confirmation-value-<%= keg.id %>">Copy</button></div><output data-copy-status aria-live="polite"></output></div><details class="disclosure"><summary>Delete Keg permanently</summary><form class="form" action="/admin/kegs/<%= keg.id %>/delete" method="post"><input type="hidden" name="_csrf" value="<%= it.page.csrfToken %>" /><label class="field">Type the exact value above to confirm <input name="confirmation" required autocomplete="off" /></label><label class="field">Reason <input name="reason" maxlength="255" /></label><p class="muted"><% for (const impact of keg.deletionImpacts) { %><%= impact.code %>: <%= impact.count %> · <% } %></p><button class="button button--danger button--small" type="submit">Permanently delete Keg</button></form></details></section>
</main>
