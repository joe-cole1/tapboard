<% layout("/layouts/admin", { page: it.page }) %>
<%~ include("/partials/admin-nav", { page: it.page, items: it.navItems || [] }) %>
<main id="main-content" class="admin-page">
  <% if (it.fill) { %>
    <div class="page-header"><p class="eyebrow">Keg Room · Filled Keg</p><h1>Filled Keg</h1><p class="muted"><%= it.fill.beverageName %> · Keg <%= it.fill.kegNumber %><% if (it.fill.kegLabel) { %> — <%= it.fill.kegLabel %><% } %></p></div>
    <%~ include("/partials/admin-messages", { page: it.page }) %>
    <div class="cluster page-actions"><a class="button button--secondary" href="<%= it.roomHref %>">Back to Keg Room</a><a class="text-link" href="/admin/keg-room/kegs/<%= it.fill.kegId %>">Physical Keg detail</a></div>
    <section aria-labelledby="filled-keg-overview"><div class="header-row"><div><h2 id="filled-keg-overview"><%= it.fill.beverageName %></h2><p class="muted">Read-first lifecycle projection.</p></div><span class="badge badge--<%= it.fill.state %>"><%= it.fill.stateLabel %></span></div><div class="keg-room-detail-visual"><%~ include("/partials/fill-graphic", { tap: { id: it.fill.id, graphic: it.fill.graphic, title: it.fill.beverageName, accessibleLabel: `${it.fill.beverageName} Filled Keg`, fillPercent: it.fill.fillPercent, displayColor: it.fill.displayColor, tapNumber: it.fill.tapNumber || 0 } }) %></div><dl class="key-value-list"><div><dt>Beverage</dt><dd><%= it.fill.beverageName %></dd></div><div><dt>Physical Keg</dt><dd>Keg <%= it.fill.kegNumber %><% if (it.fill.kegLabel) { %> — <%= it.fill.kegLabel %><% } %></dd></div><div><dt>Tap or queue</dt><dd><% if (it.fill.tapNumber) { %>Tap <%= it.fill.tapNumber %><% } else if (it.fill.queuePosition) { %>Queue position <%= it.fill.queuePosition %><% } else { %>Not queued<% } %></dd></div><div><dt>Remaining estimate</dt><dd><%= it.fill.remainingEstimate %></dd></div><div><dt>Fill date</dt><dd><%= it.fill.fillDate %></dd></div><div><dt>Updated</dt><dd><time datetime="<%= it.fill.updatedAt %>"><%= it.fill.updatedAt %></time></dd></div></dl></section>
    <section id="pour-history" aria-labelledby="filled-keg-pours">
      <div class="header-row"><div><h2 id="filled-keg-pours">Pour history</h2><p class="muted">Newest first. Times are UTC.</p></div></div>
      <% const pours = it.pourHistory; %>
      <% if (pours.cursorRejected) { %><p class="error" role="alert">That pour history link is no longer valid. Showing the newest pours.</p><% } %>
      <% if (!pours.available) { %><p class="muted">Pour history is unavailable right now.</p><% } else if (pours.entries.length === 0) { %><p class="muted"><%= pours.isFirstPage ? "No pours recorded yet." : "No older pours." %></p><% } else { %>
        <table class="table"><caption class="sr-only">Pours from this Filled Keg, newest first</caption><thead><tr><th scope="col">Volume</th><th scope="col">Poured</th></tr></thead><tbody>
          <% for (const pour of pours.entries) { %><tr><td><%= pour.volumeLabel %></td><td data-label="Poured"><%= pour.relativeLabel %> — <time datetime="<%= pour.completedAt %>"><%= pour.absoluteLabel %></time></td></tr><% } %>
        </tbody></table>
      <% } %>
      <% if (!pours.isFirstPage || pours.olderHref) { %><nav class="pagination" aria-label="Pour history pages"><% if (!pours.isFirstPage) { %><a class="button button--secondary button--small" href="<%= pours.newestHref %>">Newest pours</a><% } %><% if (pours.olderHref) { %><a class="button button--secondary button--small" href="<%= pours.olderHref %>">Older pours</a><% } %></nav><% } %>
    </section>
    <% if (it.fill.state !== "ended") { %><section aria-labelledby="filled-keg-featured"><div class="header-row"><div><h2 id="filled-keg-featured">Featured on public card</h2><p class="muted">Choose whether this active Filled Keg is highlighted on the public card.</p></div></div><form class="form" action="/admin/fills/<%= it.fill.id %>/featured" method="post"><input type="hidden" name="_csrf" value="<%= it.page.csrfToken %>" /><label class="field">Featured <select name="featured"><option value="true"<% if (it.fillRecord.featured === true) { %> selected<% } %>>On</option><option value="false"<% if (it.fillRecord.featured !== true) { %> selected<% } %>>Off</option></select></label><button class="button button--secondary button--small" type="submit">Save Featured setting</button></form></section><% } %>
    <% if (it.fill.state !== "ended") { %><section aria-labelledby="assignment"><h2 id="assignment">Tap assignment</h2><% if (it.activeTap) { %><p>Currently assigned to <strong>Tap <%= it.activeTap.tapNumber %></strong><% if (it.activeTap.name) { %> — <%= it.activeTap.name %><% } %>. Assignment lifecycle remains owned by Taps.</p><% } else if (it.availableTaps.length === 0) { %><p class="muted">No available active Taps. Assignment can be started here when a Tap is available.</p><% } else { %><p>Assign this Filled Keg through the existing Tap assignment service.</p><div class="cluster"><% for (const tap of it.availableTaps) { %><form action="/admin/taps/<%= tap.id %>/assign" method="post"><input type="hidden" name="_csrf" value="<%= it.page.csrfToken %>" /><input type="hidden" name="fillId" value="<%= it.fill.id %>" /><button class="button button--primary" type="submit">Assign to Tap <%= tap.tapNumber %><% if (tap.name) { %> — <%= tap.name %><% } %></button></form><% } %></div><% } %></section><% } %>
    <% if (it.fill.state !== "ended") { %><section aria-labelledby="filled-keg-lifecycle"><h2 id="filled-keg-lifecycle">Lifecycle</h2><%~ include("/partials/kick-keg-disclosure", { fillId: it.fill.id, csrfToken: it.page.csrfToken }) %></section><% } %>
    <% if (it.fill.state === "ended") { %><section class="card card--danger" aria-labelledby="delete-filled-keg"><h2 id="delete-filled-keg">Permanent deletion</h2><p>Deletion removes this Fill record.</p><div class="field confirmation-copy" data-copy-group><label for="fill-confirmation-value-<%= it.fill.id %>">Exact confirmation value</label><div class="confirmation-copy__row"><input id="fill-confirmation-value-<%= it.fill.id %>" readonly value="<%= it.fill.confirmationLabel %>" /><button class="button button--secondary" type="button" data-copy-target="fill-confirmation-value-<%= it.fill.id %>">Copy</button></div><output data-copy-status aria-live="polite"></output></div><details class="disclosure"><summary>Delete Filled Keg permanently</summary><form class="form" action="/admin/fills/<%= it.fill.id %>/delete" method="post"><input type="hidden" name="_csrf" value="<%= it.page.csrfToken %>" /><label class="field">Type the exact value above to confirm <input name="confirmation" required autocomplete="off" /></label><label class="field">Reason <input name="reason" maxlength="255" /></label><button class="button button--danger" type="submit">Permanently delete Filled Keg</button></form></details></section><% } %>
  <% } else { %>
    <div class="page-header"><p class="eyebrow">Keg Room · New Fill</p><h1>Fill a Keg</h1><p class="muted">Create a Filled Keg using an active, unoccupied physical Keg.</p></div>
    <%~ include("/partials/admin-messages", { page: it.page }) %>
    <div class="cluster page-actions"><a class="button button--secondary" href="<%= it.roomHref %>">Back to Keg Room</a></div>
    <section aria-labelledby="new-fill-form"><h2 id="new-fill-form">Fill a Keg</h2><% if (it.beverages.length === 0 || it.kegs.length === 0) { %><p class="muted">Add a Beverage and an available active Physical Keg before creating a Filled Keg.</p><% } else { %><form class="form" action="/admin/fills/create" method="post"><input type="hidden" name="_csrf" value="<%= it.page.csrfToken %>" /><label class="field">Beverage <select name="beverageId" required><option value="">Choose Beverage</option><% for (const beverage of it.beverages) { %><option value="<%= beverage.id %>"><%= beverage.name %></option><% } %></select></label><label class="field">Physical Keg <select name="kegId" required><option value="">Choose Keg</option><% for (const keg of it.kegs) { %><option value="<%= keg.id %>">Keg <%= keg.kegNumber %><% if (keg.label) { %> — <%= keg.label %><% } %></option><% } %></select></label><label class="field">Fill date <input name="fillDate" type="date" /></label><button class="button button--primary" type="submit">Create Filled Keg</button></form><% } %></section>
  <% } %>
</main>
