<% layout("/layouts/admin", { page: it.page }) %>
<%~ include("/partials/admin-nav", { page: it.page, nav: it.nav }) %>
<main id="main-content" class="admin-page">
  <%~ include("/partials/page-header", {
    title: it.source.name,
    intro: "Safe source metadata only. Machine key secrets and digests are never displayed.",
  }) %>
  <%~ include("/partials/admin-messages", { page: it.page }) %>
  <section aria-labelledby="source-status-heading">
    <%~ include("/partials/section-heading", {
      id: "source-status-heading",
      title: "Source status",
      intro: "Authentication and key information for this source.",
      badge: it.source.badge,
    }) %>
    <table class="table"><tbody>
      <tr><th scope="row">Key ID (audit reference)</th><td><code><%= it.source.keyPublicId %></code><br /><span class="muted">Reference only; it is not sent in the URL or request.</span></td></tr>
      <tr><th scope="row">Source created</th><td><time datetime="<%= it.source.createdAt %>"><%= it.source.createdAtLabel %></time></td></tr>
      <tr><th scope="row">Key created</th><td><time datetime="<%= it.source.keyCreatedAt %>"><%= it.source.keyCreatedAtLabel %></time></td></tr>
      <% if (it.source.disabledAt !== null) { %><tr><th scope="row">Disabled</th><td><time datetime="<%= it.source.disabledAt %>"><%= it.source.disabledAtLabel %></time></td></tr><% } %>
    </tbody></table>
  </section>
  <section aria-labelledby="source-usage-heading">
    <h2 id="source-usage-heading">Usage</h2>
    <p>Assign this source to a Tap as its level, condition, or flow source (one source can hold several roles), then send measurements to <code>POST /api/v1/telemetry/taps/{tapNumber}</code>.</p>
    <p>Authenticate with the complete machine key in <code>Authorization: Bearer …</code>. The Key ID above is an audit reference only; it is not sent in the URL or request.</p>
  </section>
  <% if (it.source.disabledAt === null) { %>
    <section aria-labelledby="source-rotate-heading">
      <%~ include("/partials/section-heading", {
        id: "source-rotate-heading",
        title: "Rotate key",
        intro: "Issues a replacement key, labelled with the source name, and shows it once. The current key stops working immediately.",
      }) %>
      <form class="form" action="/admin/integrations/telemetry-sources/<%= it.source.id %>/rotate" method="post"><input type="hidden" name="_csrf" value="<%= it.page.csrfToken %>" />
        <div class="form-actions"><button class="button button--primary button--small" type="submit">Rotate key and show replacement once</button></div>
      </form>
    </section>
    <section class="card card--danger" aria-labelledby="source-disable-heading">
      <%~ include("/partials/section-heading", {
        id: "source-disable-heading",
        title: "Disable source",
        intro: "Disabling revokes the current key for good. The source stays in history and can't be re-enabled.",
      }) %>
      <%~ include("/partials/permanent-action", { id: `source-disable-${it.source.id}`, blockers: it.disableBlockers,
        action: `/admin/integrations/telemetry-sources/${it.source.id}/disable`,
        hiddenFields: [{ name: "_csrf", value: it.page.csrfToken }], disclosure: "Disable source",
        buttonLabel: "Disable source" }) %>
    </section>
  <% } else { %>
    <section><h2>Immutable history</h2><p>This source is disabled and its current key is revoked. It cannot be rotated, renamed, or re-enabled.</p></section>
  <% } %>
</main>
