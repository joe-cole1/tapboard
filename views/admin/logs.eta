<% layout("/layouts/admin", { page: it.page }) %>
<%~ include("/partials/admin-nav", { page: it.page, nav: it.nav }) %>
<main id="main-content" class="admin-page">
  <%~ include("/partials/page-header", {
    title: "Logs",
    intro: "What happened in Tapboard, who is signed in, and how long records are kept.",
  }) %>
  <%~ include("/partials/tabs", { tabs: it.tabs }) %>
  <%~ include("/partials/admin-messages", { page: it.page }) %>
  <% if (it.workspace?.enabled) { %><p class="muted">This activity belongs to the saved simulation workspace.</p><% } %>
  <section id="activity" aria-labelledby="system-activity-heading">
    <h2 id="system-activity-heading">Activity log</h2>
    <%~ include("/partials/filter-form", it.filter) %>
    <% if (it.activity.items.length === 0) { %><p>No activity matches this view.</p><% } else { %>
        <table class="table">
          <caption class="sr-only">Activity log entries</caption>
          <thead>
            <tr>
              <th scope="col">Time</th>
              <th scope="col">Category</th>
              <th scope="col">Action</th>
              <th scope="col">Actor</th>
              <th scope="col">Resource</th>
            </tr>
          </thead>
          <tbody>
          <% for (const item of it.activity.items) { %>
            <tr>
              <td><%~ include("/partials/timestamp", { datetime: item.occurredAt, label: item.occurredAtLabel }) %></td>
              <td data-label="Category"><%= item.categoryLabel %></td>
              <td data-label="Action"><%= item.actionLabel %></td>
              <td data-label="Actor"><%= item.actorLabel %></td>
              <td data-label="Resource"><% if (item.entityHref) { %><a href="<%= item.entityHref %>"><%= item.entityLabel %></a><% } else { %><%= item.entityLabel %><% } %></td>
            </tr>
          <% } %>
        </tbody></table>
    <% } %>
    <p class="muted">Up to 50 entries per page. Activity records show actions and resource types; private details and authentication tokens are excluded.</p>
    <% if (it.activity.nextHref) { %><a class="button button--secondary" href="<%= it.activity.nextHref %>">Older activity</a><% } %>
    <% if (it.activity.hasCursor) { %><a class="button button--secondary" href="/admin/logs">Latest activity</a><% } %>
  </section>
</main>
