<% layout("/layouts/admin", { page: it.page }) %>
<%~ include("/partials/admin-nav", { page: it.page, items: it.navItems }) %>
<main id="main-content" class="admin-page">
  <header class="page-header">
    <p class="eyebrow">Beverage library</p>
    <h1>New beverage</h1>
    <p class="muted">Start with the details operators need at a glance. Advanced recipe and sensory guidance can be added now or later.</p>
  </header>
  <%~ include("/partials/admin-messages", { page: it.page }) %>
  <form class="form" action="/admin/beverages/create" method="post">
    <input type="hidden" name="_csrf" value="<%= it.page.csrfToken %>" />
    <section aria-labelledby="new-beverage-basics">
      <h2 id="new-beverage-basics">Basics</h2>
      <div class="auto-grid auto-grid--sm">
        <label class="field">Name <input name="name" maxlength="160" required autofocus /></label>
        <label class="field">Type <select name="beverageType"><% for (const type of it.beverageTypes) { %><option value="<%= type %>"><%= type[0].toUpperCase() + type.slice(1) %></option><% } %></select></label>
        <label class="field">Style <input name="style" maxlength="120" /></label>
        <label class="field">ABV (%) <input name="abv" type="number" min="0" max="100" step="0.1" /></label>
      </div>
    </section>
    <section aria-labelledby="new-beverage-presentation">
      <h2 id="new-beverage-presentation">Presentation</h2>
      <div class="auto-grid auto-grid--sm">
        <label class="field">IBU <input name="ibu" type="number" min="0" max="2000" step="0.1" /></label>
        <label class="field">Original gravity <input name="og" type="number" min="0.5" max="2" step="0.001" /></label>
        <label class="field">Final gravity <input name="fg" type="number" min="0.5" max="2" step="0.001" /></label>
        <label class="field">Manual density override <input name="manualDensityOverride" type="number" min="0.5" max="2" step="0.001" /></label>
      </div>
      <%~ include("/partials/display-colour-picker", { picker: it.colourPicker, mode: "create", id: "new-beverage-colour" }) %>
      <%~ include("/partials/fill-glass-picker", { label: "Fill Glass", name: "fillGlass", id: "new-fill-glass", selected: "", options: it.fillGlassOptions || [] }) %>
      <label class="field">Description <textarea name="description" maxlength="4000" rows="4"></textarea></label>
    </section>
    <details class="disclosure">
      <summary>Advanced settings<small>Sensory overrides and a custom recipe. Both can be added later.</small></summary>
      <h3>Sensory guidance</h3>
      <p class="muted">Optional manual overrides from 0 to 10. These bounded values drive derived guidance for Story and authenticated operators.</p>
      <div class="auto-grid auto-grid--sm">
        <% for (const axis of ["malt", "hops", "bitterness", "sweetness", "body", "roast", "tartness", "alcohol"]) { %><label class="field"><%= ({ malt: "Malt character", hops: "Hop character", alcohol: "Alcohol warmth" })[axis] || axis[0].toUpperCase() + axis.slice(1) %><input name="<%= axis %>" type="number" min="0" max="10" step="0.1" /></label><% } %>
      </div>
      <h3>Custom recipe</h3>
      <p class="muted">Optional bounded JSON for ingredients and process steps. Use the supported recipe object with <code>notes</code>, <code>ingredients</code>, and <code>steps</code>. Leave blank to add it later.</p>
      <label class="field">Recipe JSON <textarea name="recipeJson" rows="14" spellcheck="false" placeholder="{\n  &quot;notes&quot;: &quot;&quot;,\n  &quot;ingredients&quot;: [],\n  &quot;steps&quot;: []\n}"></textarea></label>
    </details>
    <div class="form-actions"><a class="button button--secondary" href="/admin/beverages">Cancel</a><button class="button button--primary" type="submit">Create beverage</button></div>
  </form>
</main>
