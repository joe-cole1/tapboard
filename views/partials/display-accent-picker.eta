<%
  // it.options: { value, label }[] (named accents); it.selected: accent, custom #rrggbb or "";
  // it.inherit: add "Use default". Custom posts accent=custom plus accentCustom=#rrggbb.
  const custom = /^#[0-9a-f]{6}$/u.test(it.selected || "");
%>
<fieldset class="display-choice display-accent-field">
  <legend>Accent color</legend>
  <div class="display-accent-options">
    <% if (it.inherit) { %>
      <label class="display-accent-option">
        <input class="display-choice__input" type="radio" name="accent" value=""<% if (!it.selected) { %> checked<% } %> />
        <span class="display-accent-swatch display-accent-swatch--inherit" aria-hidden="true"></span>
        <span>Use default</span>
      </label>
    <% } %>
    <% for (const option of it.options) { %>
      <label class="display-accent-option">
        <input class="display-choice__input" type="radio" name="accent" value="<%= option.value %>"<% if (it.selected === option.value) { %> checked<% } %> />
        <span class="display-accent-swatch display-accent-swatch--<%= option.value %>" aria-hidden="true"></span>
        <span><%= option.label %></span>
      </label>
    <% } %>
    <label class="display-accent-option">
      <input class="display-choice__input" type="radio" name="accent" value="custom"<% if (custom) { %> checked<% } %> data-accent-custom-choice />
      <span class="display-accent-swatch display-accent-swatch--custom" aria-hidden="true"></span>
      <span>Custom</span>
    </label>
  </div>
  <label class="display-accent-custom">Custom color <input type="color" name="accentCustom" value="<%= custom ? it.selected : "#fbc02d" %>" data-accent-custom-color /></label>
</fieldset>
