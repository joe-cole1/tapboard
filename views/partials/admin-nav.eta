<header class="admin-header">
  <button class="button button--icon" type="button" data-admin-menu-toggle hidden aria-controls="admin-sidebar" aria-expanded="true" aria-label="Admin menu">
    <svg class="admin-menu-icon" data-menu-icon="open" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M4 6h16M4 12h16M4 18h16" /></svg>
    <svg class="admin-menu-icon" data-menu-icon="close" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M6 6l12 12M18 6 6 18" /></svg>
  </button>
  <div class="admin-header__identity">
    <a class="admin-brand" href="/"><%= it.page.siteName || "Tapboard" %></a>
    <span class="admin-header__context">Admin</span>
  </div>
</header>
<aside id="admin-sidebar" class="admin-sidebar" data-admin-sidebar>
  <nav aria-label="Admin">
    <% for (const group of ["Overview", "Manage", "Configure"]) { const groupItems = it.items.filter((item) => item.group === group); if (groupItems.length > 0) { %>
      <section class="admin-nav-group" aria-labelledby="admin-nav-<%= group.toLocaleLowerCase() %>">
        <h2 id="admin-nav-<%= group.toLocaleLowerCase() %>"><%= group %></h2>
        <ul>
          <% for (const item of groupItems) { const active = item.activePaths.some((path) => it.page.path === path || it.page.path.startsWith(`${path}/`)); %>
            <li><a href="<%= item.href %>"<% if (active) { %> aria-current="page"<% } %>><span class="admin-nav-label"><%= item.label %></span></a></li>
          <% } %>
        </ul>
      </section>
    <% } } %>
  </nav>
  <div class="cluster admin-sidebar__account">
    <a class="button button--secondary button--small admin-exit" href="/">Exit Admin</a>
    <form action="/admin/logout" method="post">
      <input type="hidden" name="_csrf" value="<%= it.page.csrfToken %>" />
      <button class="button button--primary button--small" type="submit">Log out</button>
    </form>
  </div>
</aside>
<button class="admin-drawer-backdrop" type="button" data-admin-drawer-backdrop hidden aria-label="Close Admin menu"></button>
<% const crumbs = it.page.breadcrumbs; const parent = crumbs.at(-2); %>
<nav class="admin-breadcrumbs" aria-label="Breadcrumb">
  <% if (parent && it.page.path !== "/admin/overview") { %><a class="admin-breadcrumbs__back" href="<%= parent.href %>"><span aria-hidden="true">←</span><span class="sr-only">Back to </span><%= parent.label %></a><% } %>
  <ol class="admin-breadcrumbs__trail">
    <% for (const crumb of crumbs) { %><li><% if (crumb.href) { %><a href="<%= crumb.href %>"><%= crumb.label %></a><% } else { %><span aria-current="page"><%= crumb.label %></span><% } %></li><% } %>
  </ol>
</nav>
