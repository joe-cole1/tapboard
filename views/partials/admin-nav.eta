<header class="admin-header">
  <div class="admin-header__identity">
    <a class="admin-brand" href="/"><%= it.page.siteName || "Tapboard" %></a>
    <span class="admin-header__context">Admin</span>
  </div>
  <button class="button admin-menu-toggle" type="button" data-admin-menu-toggle hidden aria-controls="admin-sidebar" aria-expanded="false">Menu</button>
</header>
<aside id="admin-sidebar" class="admin-sidebar" data-admin-sidebar>
  <div class="admin-sidebar__controls">
    <button class="button admin-sidebar-toggle" type="button" data-admin-sidebar-toggle hidden aria-controls="admin-sidebar" aria-expanded="true">Hide menu</button>
    <button class="button admin-sidebar-close" type="button" data-admin-sidebar-close hidden>Close menu</button>
  </div>
  <nav aria-label="Admin">
    <% const sourceItems = it.items?.length ? it.items : [
      { label: "Overview", href: "/admin/overview", group: "Overview" },
      { label: "Keg Room", href: "/admin/keg-room", group: "Manage", activePaths: ["/admin/fills", "/admin/kegs", "/admin/keg-room"] },
      { label: "Taps", href: "/admin/taps", group: "Manage" },
      { label: "Beverages", href: "/admin/beverages", group: "Manage" },
      { label: "Integrations", href: "/admin/integrations", group: "Configure" },
      { label: "Display", href: "/admin/display", group: "Configure" },
      { label: "Tap Wars", href: "/admin/tap-wars", group: "Manage" },
      { label: "System", href: "/admin/system", group: "Configure" },
    ];
    const navItems = sourceItems.map((item) => ({ ...item, group: item.group || (item.href === "/admin/overview" ? "Overview" : "Manage"), activePaths: item.activePaths || [item.href] }));
    if (it.page.workspace?.enabled && !navItems.some((item) => item.href === "/admin/simulator")) navItems.push({ label: "Simulator", href: "/admin/simulator", group: "Configure", activePaths: ["/admin/simulator"] }); %>
    <% for (const group of ["Overview", "Manage", "Configure"]) { const groupItems = navItems.filter((item) => item.group === group); if (groupItems.length > 0) { %>
      <section class="admin-nav-group" aria-labelledby="admin-nav-<%= group.toLocaleLowerCase() %>">
        <h2 id="admin-nav-<%= group.toLocaleLowerCase() %>"><%= group %></h2>
        <ul>
          <% for (const item of groupItems) { const active = item.activePaths.some((path) => it.page.path === path || it.page.path.startsWith(`${path}/`)); %>
            <li><a href="<%= item.href %>"<% if (active) { %> aria-current="page"<% } %>><span class="admin-nav-label"><%= item.label %></span></a></li>
          <% } %>
        </ul>
      </section>
    <% } } %>
  </nav>
  <div class="cluster admin-sidebar__account">
    <a class="button button--secondary button--small admin-exit" href="/">Exit Admin</a>
    <form action="/admin/logout" method="post">
      <input type="hidden" name="_csrf" value="<%= it.page.csrfToken %>" />
      <button class="button button--primary button--small" type="submit">Log out</button>
    </form>
  </div>
</aside>
<button class="admin-drawer-backdrop" type="button" data-admin-drawer-backdrop hidden aria-label="Close Admin menu"></button>
<nav class="admin-breadcrumbs" aria-label="Breadcrumb">
  <% if (it.page.path !== "/admin/overview") { %><a class="admin-breadcrumbs__back" href="/admin/overview">Back to Overview</a><% } %>
  <span class="admin-breadcrumbs__wide"><a href="/admin/overview">Admin</a><span aria-hidden="true">/</span><span aria-current="page"><%= it.page.title %></span></span>
</nav>
